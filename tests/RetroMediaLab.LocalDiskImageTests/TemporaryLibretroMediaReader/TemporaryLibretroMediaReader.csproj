<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RetroMediaLab.TemporaryLibretroMediaReader</AssemblyName>
    <BaseOutputPath>bin\TemporaryLibretroMediaReader\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\TemporaryLibretroMediaReader\</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>TEMPORARY_LIBRETRO_MEDIA_READER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TemporaryLibretroMediaReader.cs" />
    <ProjectReference Include="..\..\..\src\RetroMediaLab.Emulation\RetroMediaLab.Emulation.csproj" />
    <ProjectReference Include="..\..\..\src\RetroMediaLab.Emulation.Atari\RetroMediaLab.Emulation.Atari.csproj" />
  </ItemGroup>
</Project>
