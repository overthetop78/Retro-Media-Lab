<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Product>Retro Media Lab</Product>
    <Title>Retro Media Lab</Title>
    <Company>Retro Media Lab</Company>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>retromedialab</AssemblyName>
    <RootNamespace>RetroMediaLab.Launcher</RootNamespace>
    <ApplicationIcon>..\RetroMediaLab.App\Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>..\RetroMediaLab.App\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RetroMediaLab.Tests" />
    <InternalsVisibleTo Include="RetroMediaLab.LocalEmulationTests" />
  </ItemGroup>
</Project>
