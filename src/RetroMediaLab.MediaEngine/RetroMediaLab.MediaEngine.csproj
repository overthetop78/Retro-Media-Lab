<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);RetroMediaLab_MEDIA_ENGINE_EXPLORER</DefineConstants>
    <AssemblyName>retromedialab.mediaengine</AssemblyName>
    <RootNamespace>RetroMediaLab.MediaEngine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RetroMediaLab.Tests" />
    <InternalsVisibleTo Include="RetroMediaLab.LocalEmulationTests" />
    <InternalsVisibleTo Include="RetroMediaLab.LocalDiskImageTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images\Formats\Definitions\*.cfg" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="NAudio" Version="2.3.0" PrivateAssets="all" />

    <ProjectReference Include="..\RetroMediaLab.MediaFileSystems\RetroMediaLab.MediaFileSystems.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../RetroMediaLab.MediaFileSystems/Contracts/FileSystemEntry.cs" Link="Contracts/Explorer/FileSystemEntry.cs" />
    <Compile Include="../RetroMediaLab.MediaFileSystems/Contracts/FileSystemVolume.cs" Link="Contracts/Explorer/FileSystemVolume.cs" />
    <Compile Include="../RetroMediaLab.MediaFileSystems/Contracts/FileSystemEntryAnalysis.cs" Link="Contracts/Explorer/FileSystemEntryAnalysis.cs" />
    <Compile Include="../RetroMediaLab.MediaFileSystems/Enums/FileSystemEntryKind.cs" Link="Enums/FileSystemEntryKind.cs" />
  </ItemGroup>
</Project>
