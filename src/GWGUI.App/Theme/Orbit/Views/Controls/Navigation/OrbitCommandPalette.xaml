<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.OrbitCommandPalette" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Background="{DynamicResource Orbit.Surface}" Foreground="{DynamicResource Orbit.Text}" FontFamily="Segoe UI" FontSize="12">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Button x:Name="CloseCommand" DockPanel.Dock="Right" Content="{l:Loc Common.Close}" Click="CloseClick"/>
   <TextBlock Text="{l:Loc Options.Themes.Orbit.Commands}" FontSize="23" FontWeight="Light" VerticalAlignment="Center"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,16"><Label Content="{l:Loc Options.Themes.Orbit.SearchCommands}" Target="{Binding ElementName=Search}"/><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="{l:Loc Options.Themes.Orbit.SearchCommands}"/></StackPanel>
  <Grid Grid.Row="2">
   <ListBox x:Name="Results" KeyDown="ResultKeyDown" MouseDoubleClick="ResultDoubleClick">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Title}" FontSize="14"/><TextBlock Text="{Binding Path}" Foreground="{DynamicResource Orbit.Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
      <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCheckable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="IsEnabled" Value="{Binding IsEnabled}"/></Style></ListBox.ItemContainerStyle>
   </ListBox>
   <TextBlock x:Name="Empty" Text="{l:Loc Options.Themes.Orbit.NoCommand}" Foreground="{DynamicResource Orbit.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
  <Button x:Name="Execute" Grid.Row="3" Content="{l:Loc FileDialog.Open}" Style="{StaticResource Orbit.Primary}" HorizontalAlignment="Right" Margin="0,16,0,0" Click="ExecuteClick"/>
 </Grid>
</UserControl>
