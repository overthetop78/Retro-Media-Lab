<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.ToolsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Foreground="{DynamicResource Orbit.Text}" Background="{DynamicResource Orbit.Window}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="{l:Loc Tab.Tools}" FontSize="23" FontWeight="Light"/><TextBlock x:Name="Hardware" Foreground="{DynamicResource Orbit.Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
  <TabControl x:Name="Modes" Grid.Row="1" SelectionChanged="ModeChanged">
   <TabItem Header="{l:Loc Tools.Erase}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,12,0,0" MaxWidth="650" HorizontalAlignment="Left">
     <TextBlock Text="{l:Loc Tools.EraseWarning}" Foreground="{DynamicResource Orbit.Warning}" TextWrapping="Wrap" Margin="0,0,0,20"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <CheckBox x:Name="EraseTracksEnabled" Content="{l:Loc Tools.LimitTracks}"/><TextBox x:Name="EraseTracks" Grid.Column="1" Margin="12,0,0,10"/>
      <CheckBox x:Name="EraseRevolutionsEnabled" Content="{l:Loc Tools.Revolutions}" Grid.Row="1"/><TextBox x:Name="EraseRevolutions" Grid.Column="1" Grid.Row="1" Margin="12,0,0,10"/>
     </Grid>
     <Label Content="{l:Loc Common.ExpertArguments}" Target="{Binding ElementName=EraseArguments}"/><TextBox x:Name="EraseArguments" Margin="0,0,0,20"/>
     <Button x:Name="EraseExecute" HorizontalAlignment="Left" Style="{StaticResource Orbit.Primary}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{l:Loc Tools.Clean}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,12,0,0" MaxWidth="650" HorizontalAlignment="Left">
     <TextBlock Text="{l:Loc Tools.CleanWarning}" Foreground="{DynamicResource Orbit.Muted}" TextWrapping="Wrap" Margin="0,0,0,20"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <CheckBox x:Name="CleanCylindersEnabled" Content="{l:Loc Tools.Cylinders}"/><TextBox x:Name="CleanCylinders" Grid.Column="1" Margin="12,0,0,10"/>
      <CheckBox x:Name="CleanPassesEnabled" Content="{l:Loc Tools.Passes}" Grid.Row="1"/><TextBox x:Name="CleanPasses" Grid.Column="1" Grid.Row="1" Margin="12,0,0,10"/>
      <CheckBox x:Name="CleanLingerEnabled" Content="{l:Loc Tools.Linger}" Grid.Row="2"/><TextBox x:Name="CleanLinger" Grid.Column="1" Grid.Row="2" Margin="12,0,0,10"/>
     </Grid>
     <Label Content="{l:Loc Common.ExpertArguments}" Target="{Binding ElementName=CleanArguments}"/><TextBox x:Name="CleanArguments" Margin="0,0,0,20"/>
     <Button x:Name="CleanExecute" HorizontalAlignment="Left" Style="{StaticResource Orbit.Primary}"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="ExecuteCommand" DockPanel.Dock="Right" Style="{StaticResource Orbit.Primary}"/>
   <Button x:Name="CloseCommand" Content="{l:Loc Common.Close}" Click="CloseClick" HorizontalAlignment="Left"/>
  </DockPanel>
 </Grid>
</UserControl>
