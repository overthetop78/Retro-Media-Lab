<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.EnginesOptionsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
 Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="{l:Loc Options.Engines.Description}" TextWrapping="Wrap" Foreground="{DynamicResource Orbit.Muted}" Margin="0,0,0,24"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,20"><Label Content="{l:Loc Read.Title}" Target="{Binding ElementName=PhysicalRead}"/><ComboBox x:Name="PhysicalRead"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,0,20"><Label Content="{l:Loc Write.Title}" Target="{Binding ElementName=PhysicalWrite}"/><ComboBox x:Name="PhysicalWrite"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,0,0,20"><Label Content="{l:Loc Conversion.Title}" Target="{Binding ElementName=Conversion}"/><ComboBox x:Name="Conversion"/></StackPanel>
   <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,20"><Label Content="{l:Loc Tab.Explorer}" Target="{Binding ElementName=ExplorerRead}"/><ComboBox x:Name="ExplorerRead"/></StackPanel>
  </Grid><TextBlock Text="{l:Loc Options.Engines.StrictChoice}" TextWrapping="Wrap" Foreground="{DynamicResource Orbit.Muted}"/>
 </StackPanel></ScrollViewer>
</UserControl>
