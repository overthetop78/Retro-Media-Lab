<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.VisualizationView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Foreground="{DynamicResource Orbit.Text}" Background="{DynamicResource Orbit.Window}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button x:Name="OpenToolbar" DockPanel.Dock="Right" Content="{l:Loc Visual.OpenImage}" Style="{StaticResource Orbit.Primary}"/>
   <StackPanel><TextBlock x:Name="FileName" FontSize="20" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Summary" Foreground="{DynamicResource Orbit.Muted}" Margin="0,5,12,0" TextTrimming="CharacterEllipsis"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="OverviewRow" Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="DrawingArea"/>
    <ContentControl x:Name="OverviewHost" Grid.Row="1" MaxHeight="140" Margin="0,14,0,0" HorizontalContentAlignment="Stretch"/>
   </Grid>
   <Border Grid.Column="1" Background="{DynamicResource Orbit.Surface}" CornerRadius="8" Padding="14" Margin="16,0,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <WrapPanel x:Name="DocumentChoices"/>
     <CheckBox x:Name="LinkZoomToolbar" Content="{l:Loc Visual.LinkZoom}" Margin="0,14,0,10"/>
     <Button x:Name="ResetToolbar" Content="{l:Loc Common.Reset}" Margin="0,0,0,10"/>
     <Button x:Name="InspectorToolbar" Content="{l:Loc Visual.Inspector}" Click="InspectorClick" Margin="0,0,0,10"/>
     <Button x:Name="ClassificationCommand" Content="{l:Loc Common.Advanced}" Click="ClassificationClick"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Border x:Name="EmptyState" Grid.ColumnSpan="2" Background="{DynamicResource Orbit.Window}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="{l:Loc Visual.NoFile}" FontSize="20" Margin="0,0,0,16"/><Button x:Name="EmptyOpen" Content="{l:Loc Visual.OpenImage}"/>
   </StackPanel></Border>
   <Border x:Name="Recognition" Grid.ColumnSpan="2" Background="{DynamicResource Orbit.Surface}" Padding="20" Visibility="Collapsed"><StackPanel VerticalAlignment="Center">
    <TextBlock x:Name="RecognitionStage" FontSize="20"/><TextBlock x:Name="RecognitionDetail" TextWrapping="Wrap" Margin="0,12,0,16"/><ProgressBar x:Name="RecognitionProgress"/>
   </StackPanel></Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="CloseCommand" Content="{l:Loc Common.Close}" Click="CloseClick" DockPanel.Dock="Right" Margin="12,0,0,0"/>
   <ItemsControl x:Name="Legend"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Rectangle Width="8" Height="8" Fill="{Binding Value}" Margin="0,0,6,0"/><TextBlock Text="{Binding Key}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </DockPanel>
 </Grid>
</UserControl>
