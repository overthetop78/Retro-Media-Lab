<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.VideoProcessingView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Orbit.Text}"
 Background="{DynamicResource Orbit.Window}" UseLayoutRounding="True">
 <DockPanel Margin="8">
  <ComboBox x:Name="Pages" DockPanel.Dock="Top" DisplayMemberPath="Label" SelectionChanged="PageChanged" Margin="0,0,0,12"/>
  <StackPanel x:Name="ShaderLoading" DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{l:Loc Emulation.Video.Shader.Loading}"/>
   <ProgressBar IsIndeterminate="True" Height="18" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="400"><StackPanel x:Name="Fields"/></ScrollViewer>
 </DockPanel>
</UserControl>
