<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.ModuleStorageView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Orbit.Text}"
 Background="{DynamicResource Orbit.Window}" UseLayoutRounding="True">
 <DockPanel Margin="8">
  <TextBlock DockPanel.Dock="Top" Text="{l:Loc Emulation.Storage.Device.List}" Margin="0,0,0,8"/>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <WrapPanel>
    <Button x:Name="Add" Content="{l:Loc Emulation.Storage.Device.Add}" Margin="0,0,8,4"/>
    <Button x:Name="Configure" Content="{l:Loc Emulation.Storage.Device.Configure}" Click="ConfigureClicked" Margin="0,0,8,4"/>
    <Button x:Name="Remove" Content="{l:Loc Common.Delete}" Click="RemoveClicked" Margin="0,0,0,4"/>
   </WrapPanel>
   <TextBlock Text="{l:Loc Emulation.Storage.Device.CapabilitiesHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <ListView x:Name="Devices" MinHeight="140" MaxHeight="320" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto">
   <ListView.View><GridView AllowsColumnReorder="False">
    <GridViewColumn Header="{l:Loc Emulation.Device.Name.Id}" DisplayMemberBinding="{Binding Device.Identifier}" Width="100"/>
    <GridViewColumn Header="{l:Loc Emulation.Device.Name.Type}" DisplayMemberBinding="{Binding Type}" Width="130"/>
    <GridViewColumn Header="{l:Loc Emulation.Machine.Model}" DisplayMemberBinding="{Binding Device.Model}" Width="150"/>
    <GridViewColumn Header="{l:Loc Emulation.Storage.Media.Associated}" DisplayMemberBinding="{Binding Support}" Width="180"/>
   </GridView></ListView.View>
  </ListView>
 </DockPanel>
</UserControl>
