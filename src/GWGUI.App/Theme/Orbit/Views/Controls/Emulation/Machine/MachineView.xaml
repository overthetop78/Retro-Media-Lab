<common:EmulationMachinePresentation x:Class="GWGUI.App.Theme.Orbit.Views.MachineView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:common="clr-namespace:GWGUI.App.Theme.Common" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
 xmlns:v="clr-namespace:GWGUI.App.Theme.Orbit.Views"
 Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel>
    <v:OrbitCommandToggleButton Style="{StaticResource {x:Type ToggleButton}}" x:Name="PowerCommand" Content="{l:Loc Emulation.Shortcut.Power}" Margin="0,0,8,6"/>
    <v:OrbitCommandToggleButton Style="{StaticResource {x:Type ToggleButton}}" x:Name="PauseCommand" Content="{l:Loc Emulation.Shortcut.PauseResume}" Margin="0,0,8,6"/>
    <Button x:Name="QuickSaveCommand" Content="{l:Loc Emulation.Shortcut.QuickSave}" Margin="0,0,8,6"/>
    <Button x:Name="QuickLoadCommand" Content="{l:Loc Emulation.Shortcut.QuickLoad}" Margin="0,0,8,6"/>
   </WrapPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Top">
    <Button x:Name="CaptureCommand" Content="{l:Loc Emulation.Shortcut.Screenshot}" Margin="0,0,8,6"/>
    <Button x:Name="FullscreenCommand" Content="{l:Loc Emulation.Shortcut.Fullscreen}" Margin="0,0,0,6"/>
   </WrapPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="DisplayArea" Background="Black">
    <Border x:Name="ScreenArea" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
     <Grid x:Name="VideoArea" Background="Black">
      <Border x:Name="Loading" Panel.ZIndex="1" Visibility="Collapsed" IsHitTestVisible="False" Padding="16"
       HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Orbit.Surface}">
       <StackPanel><TextBlock Text="{l:Loc Emulation.Video.Shader.Loading}"/><ProgressBar IsIndeterminate="True" Margin="0,12,0,0"/></StackPanel>
      </Border>
     </Grid>
    </Border>
   </Grid>
   <Border x:Name="DeviceBand" Grid.Column="1" Width="240" Margin="16,0,0,0" Padding="12" Visibility="Collapsed"
    Background="{DynamicResource Orbit.Surface}" CornerRadius="8">
    <DockPanel>
     <Menu DockPanel.Dock="Top" Margin="0,0,0,10"><MenuItem x:Name="SupportsMenu" Header="{l:Loc Emulation.Tab.Storage}" IsEnabled="False"/></Menu>
     <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0" MaxHeight="230">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentPresenter x:Name="DeviceContext"/></ScrollViewer>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Devices"/></ScrollViewer>
    </DockPanel>
   </Border>
   <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="{l:Loc Options.Themes.Orbit.Commands}" Margin="0,12,0,0">
    <WrapPanel>
     <Button x:Name="SoftResetCommand" Content="{l:Loc Emulation.Shortcut.SoftReset}" Margin="0,0,8,6"/>
     <Button x:Name="HardResetCommand" Content="{l:Loc Emulation.Shortcut.HardReset}" Margin="0,0,8,6"/>
     <v:OrbitCommandToggleButton Style="{StaticResource {x:Type ToggleButton}}" x:Name="AudioCommand" Content="{l:Loc Emulation.Shortcut.Mute}" Margin="0,0,8,6"/>
     <v:OrbitCommandToggleButton Style="{StaticResource {x:Type ToggleButton}}" x:Name="PointerCommand" Content="{l:Loc Emulation.Controller.Action.SwitchJoystickMouse}" Margin="0,0,8,6"/>
     <Button x:Name="CoreCommand" Content="{l:Loc Emulation.Core.NameOptions}" Margin="0,0,8,6"/>
    </WrapPanel>
   </Expander>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,10,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <TextBlock Text="{l:Loc Emulation.Tab.Controller}" Foreground="{DynamicResource Orbit.Muted}" Margin="12,0,5,0"/><Ellipse x:Name="ControllerLight" Width="7" Height="7"/>
    <TextBlock Text="{l:Loc Emulation.Tab.Mouse}" Foreground="{DynamicResource Orbit.Muted}" Margin="12,0,5,0"/><Ellipse x:Name="PointerLight" Width="7" Height="7"/>
   </StackPanel>
   <TextBlock x:Name="Renderer" DockPanel.Dock="Left" Foreground="{DynamicResource Orbit.Muted}" Margin="0,0,16,0"/>
   <TextBlock x:Name="Status" Foreground="{DynamicResource Orbit.Muted}" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
 </Grid>
</common:EmulationMachinePresentation>
