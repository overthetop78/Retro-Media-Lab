<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.EmulationView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
 Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="{l:Loc Common.Refresh}" Click="RefreshClick"/>
   <StackPanel><TextBlock Text="{l:Loc Options.Themes.Orbit.Machines}" FontSize="23" FontWeight="Light"/>
    <TextBlock Text="{l:Loc Options.Themes.Orbit.ChooseMachine}" Foreground="{DynamicResource Orbit.Muted}" Margin="0,6,16,0" TextWrapping="Wrap"/>
   </StackPanel>
  </DockPanel>
  <ListBox x:Name="Configurations" Grid.Row="1" Background="Transparent"
   SelectionChanged="SelectionChanged" MouseDoubleClick="ConfigurationDoubleClick" KeyDown="ConfigurationKeyDown"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
  </ListBox>
  <DockPanel Grid.Row="2" Margin="0,16,0,0">
   <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="{l:Loc Emulation.Machine.Open}" Click="OpenClick" Style="{StaticResource Orbit.Primary}" IsDefault="True"/>
   <Button x:Name="CloseCommand" Content="{l:Loc Common.Close}" Click="CloseClick" HorizontalAlignment="Left"/>
  </DockPanel>
 </Grid>
</UserControl>
