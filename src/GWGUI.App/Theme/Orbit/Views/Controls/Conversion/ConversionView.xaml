<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.ConversionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Foreground="{DynamicResource Orbit.Text}" Background="{DynamicResource Orbit.Window}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button x:Name="AdvancedCommand" DockPanel.Dock="Right" Content="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
   <TextBlock Text="{l:Loc Tab.Convert}" FontSize="23" FontWeight="Light"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,20"><Label Content="{l:Loc Conversion.Source}" Target="{Binding ElementName=SourcePath}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="SourcePath"/><Button x:Name="Browse" Grid.Column="1" Content="{l:Loc Common.Browse}" Margin="8,0,0,0"/>
    <Button x:Name="PreviewCommand" Grid.Column="2" Margin="8,0,0,0"/>
   </Grid><TextBlock x:Name="SourceInformation" TextWrapping="Wrap" Foreground="{DynamicResource Orbit.Muted}" Margin="0,8,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,20,0">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Label Content="{l:Loc Classification.Machine}" Target="{Binding ElementName=Machines}"/><ComboBox x:Name="Machines"/></StackPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
     <StackPanel><TextBlock x:Name="FormatInformation" TextWrapping="Wrap" Margin="0,0,0,8"/><Label Content="{l:Loc Read.Extension}"/><WrapPanel x:Name="Extensions"/></StackPanel>
    </Border>
    <ListBox x:Name="Formats" SelectionChanged="FormatSelected" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </DockPanel>
   <Border Grid.Column="1" Background="{DynamicResource Orbit.Surface}" CornerRadius="8" Padding="14">
    <DockPanel><StackPanel DockPanel.Dock="Top">
     <Label Content="{l:Loc Conversion.OutputNames}" Target="{Binding ElementName=OutputName}"/><TextBox x:Name="OutputName"/>
     <CheckBox x:Name="Tags" Content="{l:Loc Conversion.AddTags}" Margin="0,8,0,16"/>
     <Label Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}"/><ComboBox x:Name="Profiles"/>
     <WrapPanel Margin="0,10,0,16"><Button x:Name="SaveProfile" Content="{l:Loc Common.Save}" Margin="0,0,8,6"/><Button x:Name="ResetProfile" Content="{l:Loc Common.Reset}" Margin="0,0,0,6"/></WrapPanel>
     <TextBlock Text="{l:Loc Conversion.Selected}" FontSize="16" Margin="0,0,0,10"/>
    </StackPanel><ListBox x:Name="SelectedOutputs" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></DockPanel>
   </Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,18,0,0"><Button x:Name="Execute" DockPanel.Dock="Right" IsDefault="True" Style="{StaticResource Orbit.Primary}" Margin="10,0,0,0"/>
   <Button x:Name="CloseCommand" DockPanel.Dock="Left" Content="{l:Loc Common.Close}" Click="CloseClick" Margin="0,0,10,0"/>
   <Button x:Name="MigrationCommand" DockPanel.Dock="Left" Content="{l:Loc Migration.Open}" Margin="0,0,10,0"/>
   <TextBlock x:Name="Operation" VerticalAlignment="Center" Foreground="{DynamicResource Orbit.Muted}" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
 </Grid>
</UserControl>
