<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.AcquisitionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Foreground="{DynamicResource Orbit.Text}" Background="{DynamicResource Orbit.Window}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <Button x:Name="AdvancedCommand" DockPanel.Dock="Right" Content="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
   <StackPanel><TextBlock Text="{l:Loc Tab.Read}" FontSize="23" FontWeight="Light"/><TextBlock x:Name="Hardware" Foreground="{DynamicResource Orbit.Muted}" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,20,0">
    <StackPanel>
     <Label Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}"/>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Profiles"/><Button x:Name="SaveProfile" Grid.Column="1" Content="{l:Loc Common.Save}" Margin="8,0,0,0"/>
      <Button x:Name="ResetProfile" Grid.Column="2" Content="{l:Loc Common.Reset}" Margin="8,0,0,0"/>
     </Grid>
     <TextBlock Text="{l:Loc Read.ImageToCreate}" FontSize="17" Margin="0,0,0,10"/>
     <TabControl Margin="0,0,0,24">
      <TabItem x:Name="Raw" Header="{l:Loc Read.RawScp}"><DockPanel Margin="0,14,0,0">
       <TextBox x:Name="Revolutions" Width="64" DockPanel.Dock="Right"/>
       <CheckBox x:Name="RevolutionsEnabled" Content="{l:Loc Read.Revolutions}" VerticalAlignment="Center"/>
      </DockPanel></TabItem>
      <TabItem x:Name="Known" Header="{l:Loc Read.KnownFormat}"><StackPanel Margin="0,14,0,0">
       <Label Content="{l:Loc Classification.Machine}" Target="{Binding ElementName=Family}"/><ComboBox x:Name="Family" Margin="0,0,0,12"/>
       <Label Content="{l:Loc Classification.Format}" Target="{Binding ElementName=Format}"/><ComboBox x:Name="Format" Margin="0,0,0,12"/>
       <Label Content="{l:Loc Read.Extension}" Target="{Binding ElementName=Extension}"/><ComboBox x:Name="Extension"/>
      </StackPanel></TabItem>
     </TabControl>
     <Border BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
      <StackPanel><Label Content="{l:Loc Read.DestinationFolder}" Target="{Binding ElementName=Folder}"/>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="Folder"/><Button x:Name="Browse" Grid.Column="1" Content="{l:Loc Common.Browse}" Margin="8,0,0,0"/>
       </Grid>
       <Label Content="{l:Loc Read.FileName}" Target="{Binding ElementName=FileName}"/><TextBox x:Name="FileName"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Column="1" Background="{DynamicResource Orbit.Surface}" CornerRadius="8" Padding="14">
    <DockPanel><TextBlock Text="{l:Loc Logs.History}" DockPanel.Dock="Top" FontSize="17" Margin="0,0,0,12"/>
     <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="Explore" Content="{l:Loc Read.OpenExplore}" Click="ExploreClick" Margin="0,0,6,6"/>
      <Button x:Name="Visualize" Content="{l:Loc Read.OpenVisualize}" Click="VisualizeClick" Margin="0,0,0,6"/></WrapPanel>
     <ListBox x:Name="History" MouseDoubleClick="HistoryDoubleClick" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Path}"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Orbit.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="Execute" DockPanel.Dock="Right" IsDefault="True" Style="{StaticResource Orbit.Primary}"/>
   <Button x:Name="CloseCommand" Content="{l:Loc Common.Close}" Click="CloseClick" HorizontalAlignment="Left"/>
  </DockPanel>
 </Grid>
</UserControl>
