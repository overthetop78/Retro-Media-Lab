<UserControl x:Class="GWGUI.App.Theme.Orbit.Views.FirmwareSelectionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}" UseLayoutRounding="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><WrapPanel DockPanel.Dock="Right"><Button x:Name="Open" Content="{l:Loc Emulation.Firmware.Rom.OpenFolder}" Margin="0,0,8,0"/><Button x:Name="Refresh" Content="{l:Loc Common.Refresh}"/></WrapPanel>
   <TextBlock x:Name="Destination" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
  </DockPanel>
  <Grid Grid.Row="1"><ListView x:Name="Candidates" Background="Transparent" ToolTip="{Binding SelectedItem.Path,RelativeSource={RelativeSource Self}}"><ListView.View><GridView>
   <GridViewColumn Header="{l:Loc Explorer.Name}" DisplayMemberBinding="{Binding Name}" Width="240"/>
   <GridViewColumn Header="{l:Loc Read.FileName}" DisplayMemberBinding="{Binding File}" Width="180"/>
   <GridViewColumn Header="{l:Loc Emulation.Input.Binding.LabelState}" DisplayMemberBinding="{Binding Compatibility}" Width="155"/>
   <GridViewColumn Header="{l:Loc Emulation.Firmware}" DisplayMemberBinding="{Binding Destination}" Width="155"/>
  </GridView></ListView.View></ListView><TextBlock x:Name="Empty" IsHitTestVisible="False" TextWrapping="Wrap" Foreground="{DynamicResource Orbit.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="Save" Content="{l:Loc Common.Save}" IsDefault="True" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Orbit.Primary}"/>
   <Button x:Name="Cancel" Content="{l:Loc Common.Cancel}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="PathValue" IsReadOnly="True"/>
  </DockPanel>
 </Grid>
</UserControl>
