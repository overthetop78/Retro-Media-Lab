<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.ExplorerView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:v="clr-namespace:GWGUI.App.Theme.OS.Editions.WindowsXP.Views" xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="OpenCommand" Header="{l:Loc Explorer.OpenImage}"/>
    <MenuItem x:Name="ReadCommand" Header="{l:Loc Explorer.ReadDisk}"/>
    <Separator/><MenuItem x:Name="InformationCommand" Header="{l:Loc Menu.Information}" Click="InformationClick"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}">
    <MenuItem x:Name="ClassificationCommand" Header="{l:Loc Classification.Format}" Click="ClassificationClick"/>
    <MenuItem x:Name="AutomaticCommand" Header="{l:Loc Classification.Automatic}" IsCheckable="True"/>
    <MenuItem x:Name="WarningsCommand" Header="{l:Loc Explorer.Warnings}" Click="WarningsClick"/>
   </MenuItem>
  </Menu>
  <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource WindowsXP.Face}">
   <ToolBar Background="{DynamicResource WindowsXP.Face}">
    <Button x:Name="OpenToolbar" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" ToolTip="{l:Loc Explorer.OpenImage}">
     <StackPanel Orientation="Horizontal"><Image x:Name="OpenIcon" Width="24" Height="24" Margin="0,0,5,0"/>
      <TextBlock Text="{l:Loc Explorer.OpenImage}" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <Button x:Name="ReadToolbar" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" ToolTip="{l:Loc Explorer.ReadDisk}">
     <StackPanel Orientation="Horizontal"><Image x:Name="ReadIcon" Width="24" Height="24" Margin="0,0,5,0"/>
      <TextBlock x:Name="ReadCaption" Text="{l:Loc Explorer.ReadDisk}" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <Separator/>
    <Button x:Name="InformationToolbar" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" Click="InformationClick" ToolTip="{l:Loc Menu.Information}">
     <StackPanel Orientation="Horizontal"><Image x:Name="InformationIcon" Width="24" Height="24" Margin="0,0,5,0"/>
      <TextBlock Text="{l:Loc Menu.Information}" VerticalAlignment="Center"/></StackPanel>
    </Button>
   </ToolBar>
  </ToolBarTray>
  <StackPanel DockPanel.Dock="Top" Margin="6,4">
   <TextBox x:Name="Path" IsReadOnly="True"/>
   <WrapPanel Margin="0,5,0,0">
    <TextBlock x:Name="SessionLabel" Text="{l:Loc Explorer.Session}" VerticalAlignment="Center" Margin="0,0,5,0"/>
    <ComboBox x:Name="Sessions" DisplayMemberPath="DisplayName" MinWidth="130" Margin="0,0,10,0"/>
    <TextBlock x:Name="VolumeLabel" Text="{l:Loc Explorer.Volume}" VerticalAlignment="Center" Margin="0,0,5,0"/>
    <ComboBox x:Name="Volumes" DisplayMemberPath="DisplayName" MinWidth="130" Margin="0,0,10,0"/>
    <ComboBox x:Name="Formats" DisplayMemberPath="DisplayName" MinWidth="180"/>
   </WrapPanel>
   <GroupBox x:Name="OpticalTracks" Header="{l:Loc Explorer.AudioTracks}" Margin="0,6,0,0">
    <ListBox x:Name="Tracks" DisplayMemberPath="DisplayName" MaxHeight="80"/>
   </GroupBox>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <StackPanel x:Name="Recognition" Margin="6"><TextBlock x:Name="RecognitionStage"/>
    <TextBlock x:Name="RecognitionDetail" TextWrapping="Wrap" Margin="0,3,0,5"/>
    <ProgressBar x:Name="RecognitionProgress" Height="16" Minimum="0" Maximum="100"/>
   </StackPanel>
   <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,1,0,0" Padding="6,4">
    <WrapPanel>
     <TextBlock x:Name="VolumeName" Margin="0,0,20,0"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock x:Name="CapacityCaption" Margin="0,0,5,0"/><TextBlock x:Name="Capacity"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,20,0"><TextBlock x:Name="FreeCaption" Margin="0,0,5,0"/><TextBlock x:Name="Free"/></StackPanel>
     <StackPanel Orientation="Horizontal"><TextBlock x:Name="EntriesCaption" Margin="0,0,5,0"/><TextBlock x:Name="Entries"/></StackPanel>
    </WrapPanel>
   </Border>
  </StackPanel>
  <Grid Margin="6,0,6,6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="200" MinWidth="120"/><ColumnDefinition Width="5"/><ColumnDefinition MinWidth="220"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Folders" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" PreviewKeyDown="FolderKeyDown">
    <ListBox.ItemTemplate><DataTemplate><DockPanel>
     <v:WindowsXPFolderBranch Folder="{Binding}" Rows="{Binding ItemsSource,ElementName=Folders}" MouseLeftButtonDown="FolderBranchClick"/>
     <common:FileEntryIcon Category="Folder" IsExpanded="{Binding IsExpanded}" Width="16" Height="16" Margin="0,0,5,0"/>
     <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
    </DockPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource WindowsXP.Face}"/>
   <ListView x:Name="Files" Grid.Column="2" MouseDoubleClick="FileDoubleClick" KeyDown="FileKeyDown">
    <ListView.View><GridView>
     <GridViewColumn Header="{l:Loc Explorer.Name}" Width="220"><GridViewColumn.CellTemplate><DataTemplate><DockPanel>
      <common:FileEntryIcon Category="{Binding IconCategory}" Width="16" Height="16" Margin="0,0,5,0"/>
      <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListViewItem}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{l:Loc Explorer.Size}" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
     <GridViewColumn Header="{l:Loc Explorer.Type}" Width="120" DisplayMemberBinding="{Binding TypeText}"/>
     <GridViewColumn Header="{l:Loc Explorer.Modified}" Width="130" DisplayMemberBinding="{Binding ModifiedText}"/>
    </GridView></ListView.View>
   </ListView>
   <Border x:Name="EmptyState" Grid.ColumnSpan="3" Background="{DynamicResource WindowsXP.Face}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{l:Loc Visual.NoFile}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
     <Button x:Name="EmptyOpen" Content="{l:Loc Explorer.OpenImage}"/></StackPanel>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>
