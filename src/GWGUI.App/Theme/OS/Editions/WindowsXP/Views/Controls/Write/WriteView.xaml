<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.WriteView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="OpenCommand" Header="{l:Loc Options.Themes.OS.Open}"/><MenuItem x:Name="WriteCommand"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}"><MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
    <MenuItem x:Name="ModifyCommand" Header="{l:Loc Common.Modify}"/>
    <MenuItem x:Name="VisualizeCommand" Header="{l:Loc Write.VisualizeTracks}"/>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Background="White" Padding="12,10">
   <DockPanel><Image x:Name="PageIcon" Width="32" Height="32" Margin="0,0,10,0" DockPanel.Dock="Left"/>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="{l:Loc Tab.Write}" FontSize="16" FontWeight="Bold"/>
     <TextBlock x:Name="Hardware" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8">
   <Button x:Name="Execute" MinWidth="100" IsDefault="True"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
   <StackPanel Margin="12" MinWidth="430">
    <GroupBox Header="{l:Loc Write.Source}" Margin="0,0,0,12">
     <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SourcePath" Margin="0,0,8,0"/>
      <Button x:Name="Browse" Grid.Column="1" Content="{l:Loc Common.Browse}"/>
     </Grid>
    </GroupBox>
    <GroupBox Header="{l:Loc Write.Detected}" Margin="0,0,0,12">
     <StackPanel Margin="8"><TextBlock x:Name="Detection" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <ComboBox x:Name="Formats"/>
     </StackPanel>
    </GroupBox>
    <GroupBox Header="{l:Loc Profile.Title}" Margin="0,0,0,12">
     <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Profiles" Margin="0,0,8,0"/>
      <Button x:Name="SaveProfile" Grid.Column="1" Content="{l:Loc Common.Save}" Margin="0,0,8,0"/>
      <Button x:Name="ResetProfile" Grid.Column="2" Content="{l:Loc Common.Reset}"/>
     </Grid>
    </GroupBox>
    <TextBlock x:Name="Verification" TextWrapping="Wrap" Margin="8,0">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{l:Loc Write.VerifyOn}"/>
      <Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Text" Value="{l:Loc Write.VerifyOff}"/></DataTrigger></Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
