<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.CoreManagementView" x:ClassModifier="internal" x:Name="Panel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <StackPanel Margin="8">
  <GroupBox Header="{l:Loc Emulation.Core.Emulator}">
   <StackPanel>
    <ComboBox x:Name="Emulators"/>
    <TextBlock x:Name="Installed" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="Description" Margin="0,6,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </GroupBox>
  <StackPanel Margin="8,10,8,0">
   <ComboBox x:Name="Versions" Margin="0,0,0,8"/>
   <WrapPanel>
    <Button x:Name="Search" Content="{l:Loc Emulation.Core.NameSearch}" Margin="0,0,8,6"/>
    <Button x:Name="Download" Content="{l:Loc Emulation.Core.NameDownload}" Margin="0,0,8,6"/>
    <Button x:Name="Cancel" Content="{l:Loc Common.Cancel}" Margin="0,0,0,6"/>
   </WrapPanel>
   <ProgressBar x:Name="Progress" Height="18" Margin="0,4,0,8"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap"><TextBlock.Style>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Tahoma"/><Setter Property="FontSize" Value="11"/><Style.Triggers>
     <DataTrigger Binding="{Binding StatusIsError, ElementName=Panel}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
    </Style.Triggers></Style>
   </TextBlock.Style></TextBlock>
  </StackPanel>
 </StackPanel>
</UserControl>
