<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.ThemeOptionsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black">


    <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition MinHeight="100"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderThickness="3" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Padding="4" Margin="20,0,20,12"
                Background="White">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform"/>
                <TextBlock x:Name="PreviewUnavailable" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="{l:Loc Options.Themes.PreviewUnavailable}" Foreground="Black"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{l:Loc Options.Themes.List}" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeChoices" Grid.Column="1" DisplayMemberPath="Name" Margin="0,0,0,8"/>
            <TextBlock x:Name="EditionHeading" Grid.Row="1" VerticalAlignment="Center"/>
            <ComboBox x:Name="EditionChoices" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
            <TextBlock x:Name="AppearanceHeading" Grid.Row="2" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                <ComboBox x:Name="EditionAppearance"/>
                <WrapPanel x:Name="Variants"/>
            </StackPanel>
            <TextBlock x:Name="Description" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </Grid>
        <DockPanel Grid.Row="2">
            <Button x:Name="ChooseAction" DockPanel.Dock="Right" Content="{l:Loc Common.Choose}" Margin="12,0,0,0" MinWidth="90"/>
            <TextBlock x:Name="ActiveTheme" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
