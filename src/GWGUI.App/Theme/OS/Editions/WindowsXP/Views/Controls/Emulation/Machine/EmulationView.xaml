<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.EmulationView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11"
 Background="{DynamicResource WindowsXP.Face}" Foreground="Black" UseLayoutRounding="True">
 <DockPanel>
  <Menu DockPanel.Dock="Top"><MenuItem Header="{l:Loc Options.Themes.OS.File}">
   <MenuItem x:Name="OpenCommand" Header="{l:Loc Emulation.Machine.Open}" Click="OpenClick"/>
   <MenuItem x:Name="RefreshCommand" Header="{l:Loc Common.Refresh}" Click="RefreshClick"/>
   <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
  </MenuItem></Menu>
  <Border DockPanel.Dock="Top" Background="White" Padding="12,10" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1">
   <StackPanel Orientation="Horizontal"><Image x:Name="PageIcon" Width="32" Height="32" Margin="0,0,10,0"/>
    <TextBlock Text="{l:Loc Tab.Emulation}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
   </StackPanel>
  </Border>
  <DockPanel DockPanel.Dock="Bottom" Margin="8">
   <Button x:Name="RefreshButton" DockPanel.Dock="Left" Content="{l:Loc Common.Refresh}" Click="RefreshClick" MinWidth="85" Padding="10,3"/>
   <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="{l:Loc Emulation.Machine.Open}" Click="OpenClick" MinWidth="100" Padding="10,3" HorizontalAlignment="Right" IsDefault="True"/>
  </DockPanel>
  <ListBox x:Name="Configurations" Margin="8,8,8,0" SelectionChanged="SelectionChanged"
   MouseDoubleClick="ConfigurationDoubleClick" KeyDown="ConfigurationKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
 </DockPanel>
</UserControl>
