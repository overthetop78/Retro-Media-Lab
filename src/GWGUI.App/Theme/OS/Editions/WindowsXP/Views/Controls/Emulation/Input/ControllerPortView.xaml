<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.ControllerPortView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black">

 <StackPanel>
  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="TypeLabel" Margin="0,0,0,4"/><ComboBox x:Name="Type" Grid.Row="1" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="2" Text="{l:Loc Emulation.Controller.Visual}" Margin="0,0,0,4"/><ComboBox x:Name="Visual" Grid.Row="3"/>
    <TextBlock x:Name="Availability" Grid.Row="4" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </Grid>
   <Border Grid.Column="1" Background="White" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"><ContentControl x:Name="DrawingHost" Height="140"/></Border>
  </Grid>
  <StackPanel x:Name="Settings" Margin="0,0,0,8"/>
  <GroupBox Header="{l:Loc Emulation.Controller.Mappings}"><ContentControl x:Name="BindingsHost" Height="270"/></GroupBox>
  <ContentControl x:Name="OutputsHost" Margin="0,6,0,0"/>
 </StackPanel>
</UserControl>
