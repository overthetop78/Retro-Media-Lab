<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.InputBindingsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black">

 <DockPanel Margin="8">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Label Content="{l:Loc Emulation.Input.Binding.Search}" Target="{Binding ElementName=Search}"/><TextBox x:Name="Search"/></DockPanel>
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
   <Button x:Name="AssignAction" Content="{l:Loc Emulation.Input.Assign}" Click="Assign" Margin="0,0,6,4"/>
   <Button Content="{l:Loc Common.Delete}" Click="Clear" Margin="0,0,6,4"/>
   <Button Content="{l:Loc Emulation.Input.Binding.RestoreDefaults}" Click="RestoreDefaults" Margin="0,0,6,4"/>
   <Button Content="{l:Loc Emulation.Input.Binding.ClearConflicts}" Click="ClearConflicts" Margin="0,0,6,4"/>
  </WrapPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc Emulation.Input.Binding.LabelLegend}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  <ListView x:Name="Rows"><ListView.View><GridView AllowsColumnReorder="False">
   <GridViewColumn DisplayMemberBinding="{Binding Label}" Width="165"><GridViewColumn.Header><TextBlock x:Name="TargetHeader"/></GridViewColumn.Header></GridViewColumn>
   <GridViewColumn Header="{l:Loc Emulation.Input.Binding.Label}" Width="200"><GridViewColumn.CellTemplate><DataTemplate>
    <ItemsControl ItemsSource="{Binding BindingParts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Text="{Binding Text}"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Text="+" Visibility="{Binding SeparatorVisibility}" Margin="3,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
   <GridViewColumn Header="{l:Loc Emulation.Input.Binding.LabelState}" DisplayMemberBinding="{Binding StateText}" Width="130"/>
  </GridView></ListView.View></ListView>
 </DockPanel>
</UserControl>
