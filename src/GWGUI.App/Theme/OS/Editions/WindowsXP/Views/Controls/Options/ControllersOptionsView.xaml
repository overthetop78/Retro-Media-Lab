<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.ControllersOptionsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:GWGUI.App.Views.Controls.Options"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
             Loaded="PresentationLoaded" Unloaded="PresentationUnloaded" IsVisibleChanged="PresentationVisibilityChanged" FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black">


    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:Loc Controllers.Device}" Margin="0,0,0,4"/>
            <DockPanel><Button x:Name="DetectButton" DockPanel.Dock="Right" Content="{l:Loc Controllers.Detect}" Margin="8,0,0,0"/>
                <ComboBox x:Name="DeviceSelector"/></DockPanel>
            <TextBlock x:Name="DetectionStatus" Margin="0,4,0,0"/>
            <TextBlock x:Name="ProductNameText" Margin="0,4,0,0"/>
            <TextBlock x:Name="DeviceIdentityText"/>
                        <Grid x:Name="ModelSelectorPanel" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{l:Loc Controllers.VisualModel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModelSelector" Grid.Row="1"/>
                        </Grid>
        </StackPanel>
        <TabControl>
            <TabItem Header="{l:Loc Controllers.LiveInputs}">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="100"/></Grid.RowDefinitions>
                    <input:ControllerVisualizer x:Name="Visualizer"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AnalogValuesList"><ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Margin="12,0,0,0"/><TextBlock Text="{Binding Label}"/></DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="AnalogTab" Header="{l:Loc Controllers.AnalogDeadZones}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">

                        <TextBlock Text="{l:Loc Controllers.StickDeadZone}"/>
                        <DockPanel Margin="0,4,0,12"><TextBlock x:Name="StickDeadZoneText" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <Slider x:Name="StickDeadZoneSlider" PreviewMouseLeftButtonUp="DeadZoneReleased" LostKeyboardFocus="DeadZoneFocusLost"/></DockPanel>
                        <TextBlock Text="{l:Loc Controllers.TriggerDeadZone}"/>
                        <DockPanel Margin="0,4,0,12"><TextBlock x:Name="TriggerDeadZoneText" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <Slider x:Name="TriggerDeadZoneSlider" PreviewMouseLeftButtonUp="DeadZoneReleased" LostKeyboardFocus="DeadZoneFocusLost"/></DockPanel>
                        <TextBlock Text="{l:Loc Controllers.OuterDeadZone}"/>
                        <DockPanel Margin="0,4,0,12"><TextBlock x:Name="OuterDeadZoneText" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <Slider x:Name="OuterDeadZoneSlider" PreviewMouseLeftButtonUp="DeadZoneReleased" LostKeyboardFocus="DeadZoneFocusLost"/></DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="RumbleTab" Header="{l:Loc Controllers.Rumble}">
                <StackPanel Margin="8">
                    <TextBlock Text="{l:Loc Controllers.RumbleStrength}"/>
                    <DockPanel Margin="0,4,0,12"><TextBlock x:Name="RumbleStrengthText" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <Slider x:Name="RumbleStrengthSlider"/></DockPanel>
                    <WrapPanel>
                        <Button x:Name="LowFrequencyRumbleButton" Margin="0,0,8,8"/>
                        <Button x:Name="HighFrequencyRumbleButton" Margin="0,0,8,8"/>
                        <Button x:Name="LeftTriggerRumbleButton" Margin="0,0,8,8"/>
                        <Button x:Name="RightTriggerRumbleButton" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="TestStatusText"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="{l:Loc Controllers.Capabilities}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc Controllers.Control}"/>
                            <TextBlock Grid.Column="1" Text="{l:Loc Controllers.Value}"/>
                            <TextBlock Grid.Column="2" Text="{l:Loc Controllers.Active}"/>
                        </Grid>
                        <ItemsControl x:Name="ControlsGrid" Margin="0,4,0,12"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                                <CheckBox Grid.Column="2" IsChecked="{Binding Active, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <ItemsControl x:Name="CapabilitiesList" Margin="0,0,0,12"><ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Margin="0,2"><TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="160"/><TextBlock Text="{Binding Value}"/></DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="{l:Loc Controllers.Identity}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="IdentityDetailsText" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
