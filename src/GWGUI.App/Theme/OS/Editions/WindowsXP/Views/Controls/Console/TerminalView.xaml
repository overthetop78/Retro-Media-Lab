<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.TerminalView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black" UseLayoutRounding="True">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="CopyCommand" Header="{l:Loc Common.Copy}"/>
                <Separator/>
                <MenuItem Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
        </Menu>
        <DockPanel Margin="4" Background="Black">
            <TextBox x:Name="Command" Background="Black" Foreground="#C0C0C0" DockPanel.Dock="Top" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0,0,0,1"
                     FontFamily="Lucida Console" FontSize="11"/>
            <RichTextBox x:Name="Output" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="4"
                         Background="Black"
                         Foreground="#C0C0C0"
                         FontFamily="Lucida Console" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <RichTextBox.Template><ControlTemplate TargetType="RichTextBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate></RichTextBox.Template>
                <FlowDocument PagePadding="0"/>
            </RichTextBox>
        </DockPanel>
    </DockPanel>
</UserControl>
