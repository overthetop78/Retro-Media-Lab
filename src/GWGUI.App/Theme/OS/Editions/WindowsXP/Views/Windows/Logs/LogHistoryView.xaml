<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.LogHistoryView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"  FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black" UseLayoutRounding="True">
<UserControl.Resources><ResourceDictionary></ResourceDictionary></UserControl.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="ExportCommand" Header="{l:Loc Common.Export}"/>
    <Separator/>
    <MenuItem Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
  </Menu>
  <DockPanel Margin="6"><ComboBox x:Name="Files" DisplayMemberPath="Name" DockPanel.Dock="Top" Margin="0,0,0,6"/>
   <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Lucida Console" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
  </DockPanel>
 </DockPanel>
</UserControl>
