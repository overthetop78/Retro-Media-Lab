<UserControl x:Class="GWGUI.App.Theme.OS.Editions.WindowsXP.Views.FileSelectionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common"
 FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black" UseLayoutRounding="True">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Label Content="{l:Loc FileDialog.Directories}" Target="{Binding ElementName=Folders}" VerticalAlignment="Center"/>
  <ComboBox x:Name="Folders" Grid.Column="1" Grid.ColumnSpan="3" SelectionChanged="OnFolderSelected" Margin="0,0,0,8">
   <ComboBox.ItemTemplate><DataTemplate><DockPanel Margin="{Binding Indent}">
    <common:FileEntryIcon Category="Folder" IsExpanded="{Binding Expanded}" Width="16" Height="16" Margin="0,0,5,0"/>
    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
   </DockPanel></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <TextBlock x:Name="CurrentPath" Grid.Row="1" Grid.ColumnSpan="4" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
  <ListView x:Name="Files" Grid.Row="2" Grid.ColumnSpan="4" SelectionChanged="OnFileSelected" MouseDoubleClick="OnFileDoubleClick" Margin="0,0,0,10" ScrollViewer.HorizontalScrollBarVisibility="Auto">
   <ListView.View><GridView AllowsColumnReorder="False">
    <GridViewColumn Header="{l:Loc Explorer.Name}" Width="340"><GridViewColumn.CellTemplate><DataTemplate><DockPanel>
     <common:FileEntryIcon Category="{Binding Category}" Width="16" Height="16" Margin="0,0,5,0"/>
     <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" VerticalAlignment="Center"/>
    </DockPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
    <GridViewColumn Header="{l:Loc Explorer.Modified}" DisplayMemberBinding="{Binding Modified}" Width="145"/>
   </GridView></ListView.View>
  </ListView>
  <Label x:Name="NameLabel" Grid.Row="3" Content="{l:Loc Read.FileName}" Target="{Binding ElementName=NameField}" VerticalAlignment="Center"/>
  <TextBox x:Name="NameField" Grid.Row="3" Grid.Column="1" TextChanged="OnNameChanged" Margin="0,0,0,8"/>
  <Button x:Name="Accept" Grid.Row="3" Grid.Column="3" Content="{l:Loc Common.OK}" IsDefault="True" Click="OnAccept" Margin="0,0,0,8"/>
  <Label x:Name="TypesLabel" Grid.Row="4" Content="{l:Loc FileDialog.FileTypes}" Target="{Binding ElementName=Types}" VerticalAlignment="Center"/>
  <ComboBox x:Name="Types" Grid.Row="4" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="OnFilterSelected"/>
  <Button x:Name="Cancel" Grid.Row="4" Grid.Column="3" Content="{l:Loc Common.Cancel}" Click="OnCancel"/>
  <CheckBox x:Name="ReadOnly" Grid.Row="5" Grid.Column="1" Content="{l:Loc Emulation.Storage.ReadOnly}" Margin="0,8,0,0" Checked="OnReadOnlyChanged" Unchecked="OnReadOnlyChanged"/>
  <TextBlock x:Name="Error" Grid.Row="6" Grid.ColumnSpan="4" Margin="0,8,0,0" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
