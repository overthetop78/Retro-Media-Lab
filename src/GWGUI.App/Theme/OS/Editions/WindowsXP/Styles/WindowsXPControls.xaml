<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Templates come from PresentationFramework.Luna; these setters tune typography and metrics only. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}, FallbackValue=Black}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style TargetType="AccessText">
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>
    <Style x:Key="WindowsXP.Control" TargetType="Control">
        <Setter Property="FontFamily" Value="Tahoma"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource WindowsXP.Control}">
        <Setter Property="MinHeight" Value="23"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="RadioButton" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource WindowsXP.Control}">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="3,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource WindowsXP.Control}">
        <Setter Property="MinHeight" Value="22"/>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="ListBox" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="ListView" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource WindowsXP.Control}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource WindowsXP.Control}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="TreeView" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource WindowsXP.Control}"/>
    <BorderGapMaskConverter x:Key="WindowsXP.GroupHeaderGap"/>
    <Style TargetType="GroupBox" BasedOn="{StaticResource WindowsXP.Control}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox">
            <Grid SnapsToDevicePixels="True">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Margin="0,7,0,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                    <Border.OpacityMask><MultiBinding Converter="{StaticResource WindowsXP.GroupHeaderGap}" ConverterParameter="7">
                        <Binding ElementName="Header" Path="ActualWidth"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight"/>
                    </MultiBinding></Border.OpacityMask>
                </Border>
                <ContentPresenter x:Name="Header" ContentSource="Header" HorizontalAlignment="Left" Margin="10,0,0,0" RecognizesAccessKey="True"/>
                <ContentPresenter Grid.Row="1" Margin="8,4,8,8" ContentSource="Content"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="TabItem" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="Slider" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="Menu" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource WindowsXP.Control}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource WindowsXP.Control}"/>
</ResourceDictionary>
