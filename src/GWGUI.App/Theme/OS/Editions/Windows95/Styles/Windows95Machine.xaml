<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows95">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Windows95Controls.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style x:Key="Windows95MachineStateButton" TargetType="Button" BasedOn="{StaticResource Windows95Button}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1,1,0,0">
    <Border x:Name="Inner" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource Windows95ContentText}"/><Style TargetType="AccessText" BasedOn="{StaticResource Windows95ContentAccessText}"/></ContentPresenter.Resources></ContentPresenter>
    </Border>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Tag" Value="{x:Static w:Windows95Metrics.CommandActiveState}"><Setter TargetName="Outer" Property="BorderBrush" Value="#808080"/><Setter TargetName="Inner" Property="BorderBrush" Value="White"/><Setter Property="Background" Value="#DFDFDF"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#808080"/><Setter TargetName="Inner" Property="BorderBrush" Value="White"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#808080"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
