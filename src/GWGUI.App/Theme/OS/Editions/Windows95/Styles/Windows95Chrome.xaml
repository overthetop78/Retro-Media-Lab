<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:w="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows95.Views"
 xmlns:c="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows95"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
 <Style x:Key="CaptionButton" TargetType="Button">
  <Setter Property="Width" Value="{x:Static c:Windows95Metrics.CaptionButtonWidth}"/>
  <Setter Property="Height" Value="{x:Static c:Windows95Metrics.CaptionButtonHeight}"/>
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Background" Value="#C0C0C0"/>
  <Setter Property="Foreground" Value="Black"/>
  <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border BorderBrush="White" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}">
      <Border BorderBrush="Black" BorderThickness="0,0,1,1">
       <Border x:Name="Inner" BorderBrush="#808080" BorderThickness="0,0,1,1">
        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </Border>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Inner" Property="BorderThickness" Value="1,1,0,0"/>
       <Setter TargetName="Glyph" Property="RenderTransform"><Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value></Setter>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Glyph" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="{x:Type w:Windows95Window}">
  <Setter Property="MinWidth" Value="{x:Static c:Windows95Metrics.MinimumWidth}"/>
  <Setter Property="MinHeight" Value="{x:Static c:Windows95Metrics.MinimumHeight}"/>
  <Setter Property="FontFamily" Value="Microsoft Sans Serif"/>
  <Setter Property="FontSize" Value="{x:Static c:Windows95Metrics.FontSize}"/>
  <Setter Property="Background" Value="#C0C0C0"/>
  <Setter Property="Foreground" Value="Black"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
  <Setter Property="shell:WindowChrome.WindowChrome">
   <Setter.Value><shell:WindowChrome CaptionHeight="{x:Static c:Windows95Metrics.CaptionHeight}" ResizeBorderThickness="{x:Static c:Windows95Metrics.ResizeBorder}" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></Setter.Value>
  </Setter>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type w:Windows95Window}">
     <Border Background="{TemplateBinding Background}" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
      <Border BorderBrush="Black" BorderThickness="0,0,1,1">
       <Border BorderBrush="White" BorderThickness="1,1,0,0">
        <Border BorderBrush="#808080" BorderThickness="0,0,1,1" Padding="2">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="{x:Static c:Windows95Metrics.CaptionRowHeight}"/><RowDefinition/></Grid.RowDefinitions>
          <Border x:Name="Caption" Background="#000080">
           <DockPanel Margin="2,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
             <Button x:Name="Minimize" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="{l:Loc Options.Themes.Minimize}">
              <Rectangle Width="6" Height="2" Fill="Black" Margin="0,4,0,0"/>
             </Button>
             <Button x:Name="Maximize" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="{l:Loc Options.Themes.MaximizeRestore}">
              <Grid Width="10" Height="9">
               <Border x:Name="MaximizeGlyph" BorderBrush="Black" BorderThickness="1,2,1,1"/>
               <Grid x:Name="RestoreGlyph" Visibility="Collapsed">
                <Border Margin="3,0,0,3" BorderBrush="Black" BorderThickness="1,2,1,1"/>
                <Border Margin="0,3,3,0" BorderBrush="Black" BorderThickness="1,2,1,1" Background="#C0C0C0"/>
               </Grid>
              </Grid>
             </Button>
             <Button x:Name="Close" Style="{StaticResource CaptionButton}" Margin="2,0,0,0" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="{l:Loc Common.Close}">
              <Path Data="M 1,1 L 8,8 M 1,8 L 8,1" Stroke="Black" StrokeThickness="1.5" Width="9" Height="9"/>
             </Button>
            </StackPanel>
            <Button x:Name="SystemIcon" DockPanel.Dock="Left" Command="{x:Static SystemCommands.ShowSystemMenuCommand}" Width="{x:Static c:Windows95Metrics.IconSize}" Height="{x:Static c:Windows95Metrics.IconSize}"
              Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False" Margin="0,0,3,0">
             <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Button.Template>
             <Button.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{x:Static SystemCommands.CloseWindowCommand}"/></Button.InputBindings>
             <Image Source="{TemplateBinding Icon}" Width="{x:Static c:Windows95Metrics.IconSize}" Height="{x:Static c:Windows95Metrics.IconSize}"
               HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Button>
            <TextBlock x:Name="CaptionText" Text="{TemplateBinding Title}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
           </DockPanel>
          </Border>
          <AdornerDecorator Grid.Row="1" Margin="0,2,0,0"><ContentPresenter x:Name="PART_Document" Content="{TemplateBinding Document}"/></AdornerDecorator>
         </Grid>
        </Border>
       </Border>
      </Border>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsActive" Value="False"><Setter TargetName="Caption" Property="Background" Value="#808080"/><Setter TargetName="CaptionText" Property="Foreground" Value="#C0C0C0"/></Trigger>
      <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="SystemIcon" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="WindowState" Value="Maximized"><Setter TargetName="Maximize" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/><Setter TargetName="MaximizeGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="ResizeMode" Value="NoResize"><Setter TargetName="Minimize" Property="Visibility" Value="Collapsed"/><Setter TargetName="Maximize" Property="Visibility" Value="Collapsed"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</ResourceDictionary>
