<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.FirmwareSelectionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/>
  <ResourceDictionary Source="../../../Styles/Windows95Explorer.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel Margin="8">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <Button x:Name="Refresh" DockPanel.Dock="Right" Content="{l:Loc Common.Refresh}" Margin="6,0,0,0" MinWidth="80"/>
   <Button x:Name="Open" DockPanel.Dock="Right" Content="{l:Loc Emulation.Firmware.Rom.OpenFolder}" MinWidth="120"/>
   <TextBlock x:Name="Destination" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
  </DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <Border BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="3" Margin="0,0,0,8"><TextBlock x:Name="PathLabel" TextTrimming="CharacterEllipsis"/></Border>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="Save" Content="{l:Loc Common.Save}" IsDefault="True" MinWidth="80" Margin="0,0,6,0"/>
    <Button x:Name="Cancel" Content="{l:Loc Common.Cancel}" MinWidth="80"/>
   </StackPanel>
  </StackPanel>
  <Grid>
   <ListView x:Name="Candidates" ScrollViewer.HorizontalScrollBarVisibility="Auto" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}">
    <ListView.View><GridView AllowsColumnReorder="False">
     <GridViewColumn Header="{l:Loc Explorer.Name}" DisplayMemberBinding="{Binding Name}" Width="190"/>
     <GridViewColumn Header="{l:Loc Read.FileName}" DisplayMemberBinding="{Binding File}" Width="140"/>
     <GridViewColumn Header="{l:Loc Emulation.Input.Binding.LabelState}" DisplayMemberBinding="{Binding Compatibility}" Width="125"/>
     <GridViewColumn Header="{l:Loc Emulation.Firmware}" DisplayMemberBinding="{Binding Destination}" Width="130"/>
    </GridView></ListView.View>
   </ListView>
   <TextBlock x:Name="Empty" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
  </Grid>
 </DockPanel>
</UserControl>
