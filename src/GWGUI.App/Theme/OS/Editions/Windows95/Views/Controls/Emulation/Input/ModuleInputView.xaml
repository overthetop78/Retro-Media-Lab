<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.ModuleInputView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../../Styles/Windows95Controls.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel Margin="4">
  <TextBlock x:Name="Hint" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <ComboBox x:Name="Ports" DisplayMemberPath="Label" SelectionChanged="PortChanged" Margin="0,0,0,10"/>
  <Image x:Name="KeyboardArtwork" Stretch="Uniform" MaxHeight="130" Margin="0,0,0,8"/>
  <ContentControl x:Name="DrawingHost" MaxHeight="140" Margin="0,0,0,8"/>
  <ContentControl x:Name="EditorHost"/>
 </StackPanel>
</UserControl>
