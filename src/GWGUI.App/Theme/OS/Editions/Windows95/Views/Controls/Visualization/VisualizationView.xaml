<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.VisualizationView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../Styles/Windows95Desktop.xaml"/>
  <ResourceDictionary Source="../../../Styles/Windows95Explorer.xaml"/>
  <ResourceDictionary Source="../../../Styles/Windows95Visualization.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="OpenCommand" Header="{l:Loc Visual.OpenImage}"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}">
    <MenuItem x:Name="ResetCommand" Header="{l:Loc Common.Reset}"/>
    <MenuItem x:Name="LinkZoomCommand" Header="{l:Loc Visual.LinkZoom}" IsCheckable="True"/>
    <MenuItem x:Name="ClassificationCommand" Header="{l:Loc Common.Advanced}" Click="ClassificationClick"/>
    <Separator/><MenuItem x:Name="InspectorCommand" Header="{l:Loc Visual.Inspector}" Click="InspectorClick"/>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" BorderBrush="White" BorderThickness="0,1,0,0" Padding="4">
   <StackPanel>
    <WrapPanel>
     <Button x:Name="OpenToolbar" Content="{l:Loc Visual.OpenImage}" Margin="0,0,4,0"/>
     <Button x:Name="ResetToolbar" Content="{l:Loc Common.Reset}" Margin="0,0,4,0"/>
     <Button x:Name="InspectorToolbar" Content="{l:Loc Visual.Inspector}" Click="InspectorClick" Margin="0,0,10,0"/>
     <CheckBox x:Name="LinkZoomToolbar" Content="{l:Loc Visual.LinkZoom}" VerticalAlignment="Center"/>
    </WrapPanel>
    <WrapPanel x:Name="DocumentChoices" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
  <Grid DockPanel.Dock="Bottom" Margin="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="3"><TextBlock x:Name="FileName" TextTrimming="CharacterEllipsis"/></Border>
   <Border Grid.Column="1" BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="3"><TextBlock x:Name="Summary" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
  <Border x:Name="Recognition" DockPanel.Dock="Bottom" Padding="4" Visibility="Collapsed"><StackPanel><TextBlock x:Name="RecognitionStage"/><ProgressBar x:Name="RecognitionProgress" Height="14" Margin="0,3"/><TextBlock x:Name="RecognitionDetail" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
  <ItemsControl x:Name="Legend" DockPanel.Dock="Bottom" Margin="6,2">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,12,3"><Rectangle Width="8" Height="8" Fill="{Binding Value}" Margin="0,0,4,0"/><TextBlock Text="{Binding Key}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Grid>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="OverviewRow" Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="DrawingArea" Margin="4,0,4,4"/>
   <ContentControl x:Name="OverviewHost" Grid.Row="1" MaxHeight="104" Margin="4,0,4,4" HorizontalContentAlignment="Stretch"/>
   <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{l:Loc Visual.NoFile}" HorizontalAlignment="Center"/><Button x:Name="EmptyOpen" Content="{l:Loc Visual.OpenImage}" Margin="0,10,0,0"/></StackPanel>
  </Grid>
 </DockPanel>
</UserControl>
