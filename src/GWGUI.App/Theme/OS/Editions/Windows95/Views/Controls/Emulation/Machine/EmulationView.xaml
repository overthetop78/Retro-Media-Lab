<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.EmulationView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../../Styles/Windows95Desktop.xaml"/>
  <ResourceDictionary Source="../../../../Styles/Windows95Controls.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top"><MenuItem Header="{l:Loc Options.Themes.OS.File}">
   <MenuItem x:Name="OpenCommand" Header="{l:Loc Emulation.Machine.Open}" Click="OpenClick"/>
   <MenuItem x:Name="RefreshCommand" Header="{l:Loc Common.Refresh}" Click="RefreshClick"/>
   <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
  </MenuItem></Menu>
  <Border DockPanel.Dock="Top" BorderBrush="#808080" BorderThickness="0,1,0,1" Padding="3" Margin="2">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="OpenButton" Content="{l:Loc Emulation.Machine.Open}" Click="OpenClick" MinWidth="80" Margin="0,0,4,0"/>
    <Button x:Name="RefreshButton" Content="{l:Loc Common.Refresh}" Click="RefreshClick" MinWidth="80"/>
   </StackPanel>
  </Border>
  <Grid Margin="6">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Grid Margin="6,2,6,5"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <TextBlock Text="{l:Loc Emulation.Configuration.Brand}"/>
    <TextBlock Grid.Column="1" Text="{l:Loc Emulation.Configuration.Machine}"/>
   </Grid>
   <ListBox x:Name="Configurations" Grid.Row="1" SelectionChanged="SelectionChanged"
    MouseDoubleClick="ConfigurationDoubleClick" KeyDown="ConfigurationKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
  </Grid>
 </DockPanel>
</UserControl>
