<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.EnginesOptionsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/>
        <ResourceDictionary Source="../../../Styles/Windows95Explorer.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">
            <TextBlock Text="{l:Loc Options.Engines.Description}" Margin="0,0,0,12"/>
            <TextBlock Text="{l:Loc Read.Title}" Margin="0,0,0,4"/>
            <ComboBox x:Name="PhysicalRead" Margin="0,0,0,10"/>
            <TextBlock Text="{l:Loc Write.Title}" Margin="0,0,0,4"/>
            <ComboBox x:Name="PhysicalWrite" Margin="0,0,0,10"/>
            <TextBlock Text="{l:Loc Conversion.Title}" Margin="0,0,0,4"/>
            <ComboBox x:Name="Conversion" Margin="0,0,0,10"/>
            <TextBlock Text="{l:Loc Tab.Explorer}" Margin="0,0,0,4"/>
            <ComboBox x:Name="ExplorerRead" Margin="0,0,0,12"/>
            <TextBlock Text="{l:Loc Options.Engines.StrictChoice}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
