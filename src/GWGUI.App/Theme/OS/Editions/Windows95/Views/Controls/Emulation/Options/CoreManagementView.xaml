<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.CoreManagementView" x:ClassModifier="internal" x:Name="Panel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../../Styles/Windows95Controls.xaml"/>
  <ResourceDictionary Source="../../../../Styles/Windows95Explorer.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Label Content="{l:Loc Emulation.Core.Emulator}" Target="{Binding ElementName=Emulators}" VerticalAlignment="Center"/>
  <ComboBox x:Name="Emulators" Grid.Column="1" Margin="0,0,8,6"/>
  <TextBlock x:Name="Installed" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,6"/>
  <TextBlock x:Name="Description" Grid.Row="1" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,2,0,10"/>
  <ComboBox x:Name="Versions" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,8"/>
  <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
   <Button x:Name="Search" Content="{l:Loc Emulation.Core.NameSearch}" Margin="0,0,6,0"/>
   <Button x:Name="Download" Content="{l:Loc Emulation.Core.NameDownload}" Margin="0,0,6,0"/>
   <Button x:Name="Cancel" Content="{l:Loc Common.Cancel}"/>
  </StackPanel>
  <ProgressBar x:Name="Progress" Grid.Row="4" Grid.ColumnSpan="3" Height="16" Margin="0,0,0,8"/>
  <TextBlock x:Name="Status" Grid.Row="5" Grid.ColumnSpan="3" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="Black"/><Style.Triggers><DataTrigger Binding="{Binding StatusIsError, ElementName=Panel}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid>
</UserControl>
