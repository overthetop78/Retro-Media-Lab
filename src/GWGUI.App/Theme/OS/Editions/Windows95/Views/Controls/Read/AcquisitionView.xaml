<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.AcquisitionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
             FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Styles/Windows95Desktop.xaml"/>
        <ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#C0C0C0" Foreground="Black" Padding="0">
      <MenuItem Header="{l:Loc Options.Themes.OS.File}">
        <MenuItem x:Name="BrowseCommand" Header="{l:Loc Read.DestinationFolder}"/>
        <MenuItem x:Name="ExecuteCommand"/>
        <Separator/>
        <MenuItem x:Name="ExploreCommand" Header="{l:Loc Read.OpenExplore}" Click="ExploreClick"/>
        <MenuItem x:Name="VisualizeCommand" Header="{l:Loc Read.OpenVisualize}" Click="VisualizeClick"/>
        <Separator/>
        <MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
      </MenuItem>
      <MenuItem Header="{l:Loc Menu.Options}">
        <MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
        <MenuItem Header="{l:Loc Profile.Title}">
          <MenuItem x:Name="SaveProfile" Header="{l:Loc Common.Save}"/>
          <MenuItem x:Name="ResetProfile" Header="{l:Loc Common.Reset}"/>
        </MenuItem>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" BorderBrush="White" BorderThickness="0,1,0,0" Padding="4">
      <DockPanel>
        <Button x:Name="Execute" DockPanel.Dock="Left" Margin="0,0,8,0" MinWidth="90" IsDefault="True"/>
        <Label DockPanel.Dock="Left" Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}"/>
        <ComboBox x:Name="Profiles" MinWidth="160" MaxWidth="320" HorizontalAlignment="Left"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="3" Margin="2">
      <TextBlock x:Name="Hardware" TextTrimming="CharacterEllipsis"/>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
      <Grid Margin="8" MinWidth="480">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition MinHeight="130"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Label Content="{l:Loc Read.Folder}" Target="{Binding ElementName=Folder}"/>
          <TextBox x:Name="Folder" Grid.Column="1" Margin="0,2,6,2"/>
          <Button x:Name="Browse" Grid.Column="2" Content="{l:Loc Common.Browse}" Margin="0,2"/>
          <Label Grid.Row="1" Content="{l:Loc Read.FileName}" Target="{Binding ElementName=FileName}"/>
          <TextBox x:Name="FileName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"/>
        </Grid>
        <TabControl x:Name="CaptureMode" Grid.Row="1" Margin="0,0,0,10">
          <TabItem x:Name="Raw" Header="{l:Loc Read.RawScp}">
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="RevolutionsEnabled" Content="{l:Loc Read.Revolutions}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="Revolutions" Width="54"/>
            </StackPanel>
          </TabItem>
          <TabItem x:Name="Known" Header="{l:Loc Read.KnownFormat}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Label Content="{l:Loc Classification.Machine}" Target="{Binding ElementName=Family}"/>
              <Label Grid.Column="1" Content="{l:Loc Classification.Format}" Target="{Binding ElementName=Format}"/>
              <Label Grid.Column="2" Content="{l:Loc Read.Extension}" Target="{Binding ElementName=Extension}"/>
              <ComboBox x:Name="Family" Grid.Row="1" Margin="0,0,6,0"/>
              <ComboBox x:Name="Format" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0"/>
              <ComboBox x:Name="Extension" Grid.Row="1" Grid.Column="2"/>
            </Grid>
          </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="Explore" Content="{l:Loc Read.OpenExplore}" Click="ExploreClick" Margin="0,0,6,0"/>
              <Button x:Name="Visualize" Content="{l:Loc Read.OpenVisualize}" Click="VisualizeClick"/>
            </StackPanel>
            <Label Content="{l:Loc Logs.History}"/>
          </DockPanel>
          <ListBox x:Name="History" SelectionMode="Single" MouseDoubleClick="HistoryDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2" ToolTip="{Binding Path}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding FileName}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{l:Loc Status.Running}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Text" Value="{l:Loc Status.Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
