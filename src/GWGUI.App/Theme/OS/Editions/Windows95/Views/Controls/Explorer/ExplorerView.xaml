<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows95.Views.ExplorerView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:v="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows95.Views" xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
 FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../Styles/Windows95Desktop.xaml"/>
  <ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/>
  <ResourceDictionary Source="../../../Styles/Windows95Explorer.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="OpenCommand" Header="{l:Loc Explorer.OpenImage}"/>
    <MenuItem x:Name="ReadCommand" Header="{l:Loc Explorer.ReadDisk}"/>
    <Separator/><MenuItem x:Name="InformationCommand" Header="{l:Loc Menu.Information}" Click="InformationClick"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}">
    <MenuItem x:Name="ClassificationCommand" Header="{l:Loc Classification.Format}" Click="ClassificationClick"/>
    <MenuItem x:Name="AutomaticCommand" Header="{l:Loc Classification.Automatic}" IsCheckable="True"/>
    <MenuItem x:Name="WarningsCommand" Header="{l:Loc Explorer.Warnings}" Click="WarningsClick"/>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" BorderBrush="White" BorderThickness="0,1,0,0" Padding="4">
   <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
     <Button x:Name="OpenToolbar" Content="{l:Loc Explorer.OpenImage}" Margin="0,0,4,0"/>
     <Button x:Name="ReadToolbar" Content="{l:Loc Explorer.ReadDisk}" Margin="0,0,4,0"/>
     <Button x:Name="InformationToolbar" Content="{l:Loc Menu.Information}" Click="InformationClick"/>
    </StackPanel>
    <TextBox x:Name="Path" IsReadOnly="True"/>
    <WrapPanel Margin="0,4,0,0">
     <TextBlock x:Name="SessionLabel" Text="{l:Loc Explorer.Session}" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <ComboBox x:Name="Sessions" DisplayMemberPath="DisplayName" MinWidth="140" Margin="0,0,8,0"/>
     <TextBlock x:Name="VolumeLabel" Text="{l:Loc Explorer.Volume}" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <ComboBox x:Name="Volumes" DisplayMemberPath="DisplayName" MinWidth="140" Margin="0,0,8,0"/>
     <ComboBox x:Name="Formats" DisplayMemberPath="DisplayName" MinWidth="180"/>
    </WrapPanel>
    <StackPanel x:Name="OpticalTracks" Margin="0,4,0,0"><Label Content="{l:Loc Explorer.AudioTracks}"/><ListBox x:Name="Tracks" DisplayMemberPath="DisplayName" MaxHeight="80"/></StackPanel>
   </StackPanel>
  </Border>
  <StackPanel DockPanel.Dock="Bottom">
   <StackPanel x:Name="Recognition" Margin="4,2"><TextBlock x:Name="RecognitionStage"/><TextBlock x:Name="RecognitionDetail"/><ProgressBar x:Name="RecognitionProgress" Height="14" Minimum="0" Maximum="100"/></StackPanel>
   <Border BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="3" Margin="2">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock x:Name="VolumeName" TextTrimming="CharacterEllipsis"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="CapacityCaption" Margin="0,0,4,0"/><TextBlock x:Name="Capacity"/></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="FreeCaption" Margin="0,0,4,0"/><TextBlock x:Name="Free"/></StackPanel>
     <StackPanel Grid.Column="3" Orientation="Horizontal"><TextBlock x:Name="EntriesCaption" Margin="0,0,4,0"/><TextBlock x:Name="Entries"/></StackPanel>
    </Grid>
   </Border>
  </StackPanel>
  <Grid Margin="4,0,4,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="120"/><ColumnDefinition Width="4"/><ColumnDefinition Width="5*" MinWidth="220"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Folders" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" PreviewKeyDown="FolderKeyDown">
    <ListBox.ItemTemplate><DataTemplate><DockPanel>
     <v:Windows95FolderBranch Folder="{Binding}" Rows="{Binding ItemsSource, ElementName=Folders}" MouseLeftButtonDown="FolderBranchClick"/>
     <common:FileEntryIcon Category="Folder" IsExpanded="{Binding IsExpanded}" Width="16" Height="16" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
     <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
    </DockPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#C0C0C0"/>
   <ListView x:Name="Files" Grid.Column="2" MouseDoubleClick="FileDoubleClick" KeyDown="FileKeyDown">
    <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource {x:Type GridViewColumnHeader}}">
     <GridViewColumn Header="{l:Loc Explorer.Name}" Width="240"><GridViewColumn.CellTemplate><DataTemplate><DockPanel>
      <common:FileEntryIcon Category="{Binding IconCategory}" Width="16" Height="16" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{l:Loc Explorer.Modified}" Width="140"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{l:Loc Explorer.Type}" Width="120"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TypeText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     <GridViewColumn Header="{l:Loc Explorer.Size}" Width="80"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
    </GridView></ListView.View>
   </ListView>
   <Border x:Name="EmptyState" Grid.ColumnSpan="3" Background="#C0C0C0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{l:Loc Visual.NoFile}" HorizontalAlignment="Center" Margin="0,0,0,8"/><Button x:Name="EmptyOpen" Content="{l:Loc Explorer.OpenImage}"/></StackPanel></Border>
  </Grid>
 </DockPanel>
</UserControl>
