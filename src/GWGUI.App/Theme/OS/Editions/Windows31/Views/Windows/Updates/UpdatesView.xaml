<UserControl x:ClassModifier="internal" x:Class="GWGUI.App.Theme.OS.Editions.Windows31.Views.UpdatesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
 <UserControl.Resources>
  <DataTemplate x:Key="NavigationItem">
   <StackPanel Margin="4,3">
    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ReleaseItem">
   <GroupBox Header="{Binding DisplayName}" Margin="0,0,0,8">
    <StackPanel>
     <TextBlock Text="{Binding InstalledLabel}" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap" Margin="0,4,0,4"/>
     <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
       IsEnabled="{Binding CanSelectVersion}" SelectionChanged="VersionChanged"/>
    </StackPanel>
   </GroupBox>
  </DataTemplate>
  <DataTemplate x:Key="AvailableItem">
   <GroupBox Header="{Binding DisplayName}" Margin="0,0,0,8">
    <DockPanel>
     <Button DockPanel.Dock="Right" Content="{l:Loc Updates.ModuleDirectoryInstall}" IsEnabled="{Binding CanInstall}" Click="InstallAvailable" Margin="8,0,0,0"/>
     <StackPanel>
      <TextBlock Text="{Binding DetailsLabel}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding StateLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
    </DockPanel>
   </GroupBox>
  </DataTemplate>
 </UserControl.Resources>
 <DockPanel Margin="10">
  <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <Button x:Name="FooterCommand" DockPanel.Dock="Right" IsDefault="True" Margin="8,0,0,0"/>
   <TextBlock x:Name="FooterHint" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox x:Name="Navigation" ItemTemplate="{StaticResource NavigationItem}"/>
   <Grid Grid.Column="2">
    <DockPanel x:Name="ApplicationPage">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel Margin="0,0,0,8"><Button x:Name="Search"/><Button x:Name="Install" Margin="8,0,0,0"/><Button x:Name="Cancel" Margin="8,0,0,0"/></WrapPanel>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ProgressBar x:Name="Progress" Height="16" Margin="0,0,0,8"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Results" ItemTemplate="{StaticResource ReleaseItem}"/></ScrollViewer>
    </DockPanel>
    <DockPanel x:Name="DirectoryPage">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{l:Loc Updates.ModuleDirectoryDescription}" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <TextBlock Text="{l:Loc Updates.ModulePackageExplanation}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Button x:Name="SearchAvailable" HorizontalAlignment="Left" Margin="0,0,0,8"/>
      <TextBlock x:Name="AvailableStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ProgressBar x:Name="AvailableProgress" Height="16" Margin="0,0,0,8"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AvailableResults" ItemTemplate="{StaticResource AvailableItem}"/></ScrollViewer>
    </DockPanel>
    <DockPanel x:Name="ModulePage">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding SelectedItem.Title, ElementName=Navigation}" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding SelectedItem.Subtitle, ElementName=Navigation}" Margin="0,0,0,8"/>
      <WrapPanel Margin="0,0,0,8"><Button x:Name="SearchModules"/><Button x:Name="InstallModules" Margin="8,0,0,0"/><Button x:Name="CancelModules" Margin="8,0,0,0"/></WrapPanel>
      <TextBlock x:Name="ModuleStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ProgressBar x:Name="ModulesProgress" Height="16" Margin="0,0,0,8"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ModuleResults" ItemTemplate="{StaticResource ReleaseItem}"/></ScrollViewer>
    </DockPanel>
    <ScrollViewer x:Name="AdvancedPage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="{l:Loc Updates.ModuleInstallDescription}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Button x:Name="InstallFile" HorizontalAlignment="Left" Margin="0,0,0,16"/>
      <TextBlock Text="{l:Loc Updates.ModuleCatalogUrlHint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <TextBox x:Name="CatalogUrl" Margin="0,0,0,8"/>
      <Button x:Name="InstallUrl" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <TextBlock x:Name="ManualStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ProgressBar x:Name="ManualProgress" Height="16"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </DockPanel>
</UserControl>
