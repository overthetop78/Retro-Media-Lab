<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows31.Views.EmulationPreferencesView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
 <DockPanel Margin="8">
  <Button DockPanel.Dock="Bottom" Content="{l:Loc Common.Close}" Click="CloseClick" HorizontalAlignment="Right" Margin="0,8,0,0"/>
  <TabControl x:Name="Pages">
   <TabItem Header="{l:Loc Emulation.Tab.General}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
     <StackPanel Margin="12" MinWidth="400">
      <TextBlock Text="{l:Loc Emulation.Folder.StorageBase}"/>
      <DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="{l:Loc Common.Browse}" Tag="Storage" Click="BrowseClick" Margin="8,0,0,0"/><TextBox x:Name="Storage" LostKeyboardFocus="FolderFinished"/></DockPanel>
      <TextBlock Text="{l:Loc Emulation.Folder.Capture}"/>
      <DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="{l:Loc Common.Browse}" Tag="Capture" Click="BrowseClick" Margin="8,0,0,0"/><TextBox x:Name="Capture" LostKeyboardFocus="FolderFinished"/></DockPanel>
      <TextBlock Text="{l:Loc Emulation.Folder.State}"/>
      <DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="{l:Loc Common.Browse}" Tag="State" Click="BrowseClick" Margin="8,0,0,0"/><TextBox x:Name="State" LostKeyboardFocus="FolderFinished"/></DockPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{l:Loc Emulation.Tab.Shortcuts}"><ContentControl x:Name="Shortcuts" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></TabItem>
   <TabItem Header="{l:Loc Emulation.Configuration}">
    <DockPanel Margin="8">
     <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{l:Loc Emulation.Configuration.Brand}"/><ComboBox x:Name="Brands" SelectionChanged="BrandChanged" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="{l:Loc Emulation.Configuration.Machine}"/><ComboBox x:Name="Machines" SelectionChanged="MachineChanged" Margin="0,4,0,0"/></StackPanel>
     </Grid>
     <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="EditAction" Content="{l:Loc Common.Modify}" Click="EditClick" Margin="0,0,6,0"/>
      <Button x:Name="DeleteAction" Content="{l:Loc Common.Delete}" Click="DeleteClick"/>
     </WrapPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock Text="{l:Loc Emulation.Configuration.Readers}"/>
      <ItemsControl ItemsSource="{Binding SelectedItem.ReaderGlyphs, ElementName=Configurations}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{DynamicResource Windows31DeviceSymbols}" Margin="0,3,6,5"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{l:Loc Emulation.Configuration.Peripherals}"/>
      <ItemsControl ItemsSource="{Binding SelectedItem.PeripheralGlyphs, ElementName=Configurations}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{DynamicResource Windows31DeviceSymbols}" Margin="0,3,6,0"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="{l:Loc Emulation.Configuration.Machine}"/>
      <TextBlock Grid.Column="1" Text="{l:Loc Emulation.Tab.Cpu}"/>
      <TextBlock Grid.Column="2" Text="{l:Loc Emulation.Configuration.TotalRam}"/>
     </Grid>
     <ListBox x:Name="Configurations" HorizontalContentAlignment="Stretch" SelectionChanged="ConfigurationChanged" MouseDoubleClick="ConfigurationDoubleClick">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="4">
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding MachineName}" TextWrapping="Wrap" Margin="0,0,8,0"/>
       <TextBlock Grid.Column="1" Text="{Binding Cpu}" Margin="0,0,8,0"/>
       <TextBlock Grid.Column="2" Text="{Binding TotalRam}"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </TabItem>
   <TabItem Header="{l:Loc Emulation.Network.Title}"><ContentControl x:Name="Network" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
