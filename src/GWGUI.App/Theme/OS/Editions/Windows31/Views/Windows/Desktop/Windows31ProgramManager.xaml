<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows31.Windows31ProgramManager"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Styles/Windows31Controls.xaml"/>
                <ResourceDictionary Source="../../../Styles/Windows31Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProgramLauncher" TargetType="ListBoxItem">
                <Setter Property="Width" Value="{x:Static w:Windows31Metrics.IconWidth}"/>
                <Setter Property="Height" Value="{x:Static w:Windows31Metrics.IconHeight}"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static w:Windows31PaletteResources.WindowText}}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><w:Windows31ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Top"/></ControlTemplate></Setter.Value></Setter>
                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static w:Windows31PaletteResources.Selection}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static w:Windows31PaletteResources.SelectionText}}"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="IconList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Background="{TemplateBinding Background}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static w:Windows31PaletteResources.ApplicationWorkspace}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Menu x:Name="MenuBar">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="OpenCommand" Header="{l:Loc Options.Themes.OS.Open}" Click="OpenSelectedClick" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
            <MenuItem x:Name="SharedOptions" Header="{l:Loc Menu.Options}">
                <MenuItem x:Name="PreferencesCommand" Header="{l:Loc Menu.Preferences}" Click="PreferencesClick"/>
                <MenuItem x:Name="EmulationPreferencesCommand" Header="{l:Loc Menu.EmulationPreferences}" Click="EmulationPreferencesClick" IsEnabled="False"/>
            </MenuItem>
            <MenuItem x:Name="GroupsMenu" Header="{l:Loc Options.Themes.OS.Window}">
                <MenuItem Header="{l:Loc Options.Themes.OS.Cascade}" Click="CascadeClick"/>
                <MenuItem Header="{l:Loc Options.Themes.OS.Tile}" Click="TileClick"/>
                <MenuItem Header="{l:Loc Options.Themes.OS.ArrangeIcons}" Click="ArrangeIconsClick"/>
                <Separator/>
            </MenuItem>
            <MenuItem x:Name="SharedHelp" Header="{l:Loc Menu.Help}">
                <MenuItem Header="{l:Loc Menu.Documentation}" Click="DocumentationClick"/>
                <MenuItem Header="{l:Loc Menu.About}" Click="AboutClick"/>
            </MenuItem>
        </Menu>
        <Canvas x:Name="GroupArea" Grid.Row="1" ClipToBounds="True" Background="{DynamicResource {x:Static w:Windows31PaletteResources.ApplicationWorkspace}}" SizeChanged="GroupAreaSizeChanged">
            <ListBox x:Name="GroupIcons" Style="{StaticResource IconList}" MouseDoubleClick="GroupIconDoubleClick" KeyDown="GroupIconKeyDown"/>
        </Canvas>
    </Grid>
</UserControl>
