<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows31.Views.GeneralOptionsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <TabControl Margin="8">
        <TabItem Header="{l:Loc Options.General}">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="{l:Loc Options.ImagesFolder}" Margin="0,0,0,4"/>
                <DockPanel Grid.Row="1" Margin="0,0,0,14">
                    <Button x:Name="BrowseAction" DockPanel.Dock="Right" Content="{l:Loc Common.Browse}" Click="BrowseClick" Margin="8,0,0,0"/>
                    <TextBox x:Name="ImagesFolder" LostKeyboardFocus="FolderEditingFinished"/>
                </DockPanel>
                <TextBlock Grid.Row="2" Text="{l:Loc Options.Language}" Margin="0,0,0,4"/>
                <ComboBox x:Name="Languages" Grid.Row="3" VerticalAlignment="Top"/>
            </Grid>
        </TabItem>
        <TabItem Header="{l:Loc Tab.Convert}">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <CheckBox x:Name="UseTags" Content="{l:Loc Options.UseConversionTags}" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*" MinWidth="230"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{l:Loc Options.TagPreset}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TagPresets" Grid.Row="1" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="{l:Loc Options.TagPattern}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TagPattern" Grid.Row="3" Margin="0,0,0,8" LostKeyboardFocus="PatternEditingFinished"/>
                        <TextBlock Grid.Row="4" Text="{l:Loc Options.RecentTagPatterns}" Margin="0,0,0,4"/>
                        <ListBox x:Name="RecentPatterns" Grid.Row="5" MouseDoubleClick="RecentDoubleClick" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate><DataTemplate>
                                <DockPanel><TextBlock Text="{Binding Number}" Width="20"/><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DockPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Options.TagVariablesTitle}" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="Variables">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Token}" FontFamily="{DynamicResource Windows31FixedFont}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="NextAction" DockPanel.Dock="Right" Content="{l:Loc Options.NextTagExample}" Margin="8,0,0,0" Click="NextExampleClick"/>
                    <Border BorderThickness="1" Padding="4" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.WindowFrame}}" Background="{DynamicResource {x:Static w:Windows31PaletteResources.Window}}">
                        <TextBlock x:Name="Preview" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static w:Windows31PaletteResources.WindowText}}"/>
                    </Border>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
