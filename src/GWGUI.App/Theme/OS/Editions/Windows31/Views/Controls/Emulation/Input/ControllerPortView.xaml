<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows31.Views.ControllerPortView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
 <StackPanel>
  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0">
    <TextBlock x:Name="TypeLabel" Margin="0,0,0,4"/><ComboBox x:Name="Type" Margin="0,0,0,8"/>
    <TextBlock Text="{l:Loc Emulation.Controller.Visual}" Margin="0,0,0,4"/><ComboBox x:Name="Visual"/>
    <TextBlock x:Name="Availability" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel>
   <ContentControl x:Name="DrawingHost" Grid.Column="1" Height="140"/>
  </Grid>
  <StackPanel x:Name="Settings" Margin="0,0,0,8"/>
  <ContentControl x:Name="BindingsHost" Height="270"/>
  <ContentControl x:Name="OutputsHost" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>
