<UserControl x:Class="GWGUI.App.Theme.OS.Editions.Windows31.Views.EmulationView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="OpenCommand" Header="{l:Loc Emulation.Machine.Open}" Click="OpenClick"/>
                <MenuItem x:Name="RefreshCommand" Header="{l:Loc Common.Refresh}" Click="RefreshClick"/>
                <Separator/>
                <MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
        </Menu>
        <Grid Margin="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="6,0,6,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{l:Loc Emulation.Configuration.Brand}"/>
                <TextBlock Grid.Column="1" Text="{l:Loc Emulation.Configuration.Machine}"/>
            </Grid>
            <ListBox x:Name="Configurations" Grid.Row="1" SelectionChanged="SelectionChanged"
                     MouseDoubleClick="ConfigurationDoubleClick" KeyDown="ConfigurationKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Button x:Name="OpenButton" Grid.Row="2" Content="{l:Loc Emulation.Machine.Open}"
                    HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="110" Click="OpenClick"/>
        </Grid>
    </DockPanel>
</UserControl>
