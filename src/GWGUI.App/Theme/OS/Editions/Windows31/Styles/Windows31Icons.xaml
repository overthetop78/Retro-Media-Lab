<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:w="clr-namespace:GWGUI.App.Theme.OS.Editions.Windows31"
                    xmlns:dialog="clr-namespace:System.Windows;assembly=PresentationFramework">
    <BitmapImage x:Key="{x:Static w:Windows31ApplicationId.Read}" UriSource="../Assets/Icons/read.ico" CacheOption="OnLoad"/>
    <BitmapImage x:Key="{x:Static w:Windows31ApplicationId.Write}" UriSource="../Assets/Icons/write.ico" CacheOption="OnLoad"/>
    <BitmapImage x:Key="{x:Static w:Windows31ApplicationId.Conversion}" UriSource="../Assets/Icons/conversion.ico" CacheOption="OnLoad"/>
    <BitmapImage x:Key="{x:Static w:Windows31ApplicationId.Visualization}" UriSource="../Assets/Icons/visualization.ico" CacheOption="OnLoad"/>
    <BitmapImage x:Key="{x:Static w:Windows31ApplicationId.Explorer}" UriSource="../Assets/Icons/explorer.ico" CacheOption="OnLoad"/>
