    <BitmapImage x:Key="{x:Static dialog:MessageBoxImage.Warning}" UriSource="../Assets/Icons/message-warning.ico" CacheOption="OnLoad"/>
    <BitmapImage x:Key="{x:Static dialog:MessageBoxImage.Error}" UriSource="../Assets/Icons/message-error.ico" CacheOption="OnLoad"/>
    <BitmapImage x:Key="{x:Static dialog:MessageBoxImage.Question}" UriSource="../Assets/Icons/message-question.ico" CacheOption="OnLoad"/>
