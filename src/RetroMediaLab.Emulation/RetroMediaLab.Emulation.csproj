<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>retromedialab.emulation</AssemblyName>
    <PackageId>RetroMediaLab.Emulation.SDK</PackageId>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Description>Versioned contracts for independent Retro Media Lab emulation modules.</Description>
    <Authors>overthetop78</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/overthetop78/Retro-Media-Lab</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\RetroMediaLab.MediaEngine\RetroMediaLab.MediaEngine.csproj" PrivateAssets="all" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" PrivateAssets="all" />
    <PackageReference Include="NAudio" Version="2.3.0" PrivateAssets="all" />
    <PackageReference Include="LTRData.DiscUtils.Vhd" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Vhdx" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Vdi" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Vmdk" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Fat" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Ntfs" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.ExFat" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Ext" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.HfsPlus" Version="1.0.88" />
    <InternalsVisibleTo Include="RetroMediaLab.Tests" />
    <InternalsVisibleTo Include="RetroMediaLab.LocalEmulationTests" />
    <InternalsVisibleTo Include="RetroMediaLab.LocalDiskImageTests" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeMediaEngineRuntime</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <!-- Le SDK transporte ses composants média sans demander des paquets de projets non publiés. -->
  <Target Name="IncludeMediaEngineRuntime" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="runtimes/any/lib/$(TargetFramework)/" />
      <TfmSpecificPackageFile Include="@(ReferenceCopyLocalPaths)" PackagePath="runtimes/any/lib/$(TargetFramework)/" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And ('%(ReferenceCopyLocalPaths.Filename)' == 'retromedialab.mediaengine' Or '%(ReferenceCopyLocalPaths.Filename)' == 'retromedialab.mediafilesystems' Or '%(ReferenceCopyLocalPaths.Filename)' == 'retromedialab.mediaanalysis' Or '%(ReferenceCopyLocalPaths.Filename)' == 'retromedialab.chips')" />
      <TfmSpecificPackageFile Include="@(ReferenceCopyLocalPaths)" PackagePath="lib/$(TargetFramework)/" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'retromedialab.chips' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\RetroMediaLab.Chips\RetroMediaLab.Chips.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
