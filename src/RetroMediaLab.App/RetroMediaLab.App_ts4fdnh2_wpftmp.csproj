<Project>
  <PropertyGroup>
    <AssemblyName>retromedialab.app</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>F:\GW GUI\src\RetroMediaLab.App\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>RetroMediaLab.App</_TargetAssemblyProjectName>
    <RootNamespace>RetroMediaLab.App</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RetroMediaLab.App</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.4.1</Version>
    <Authors>overthetop78</Authors>
    <Company>Retro Media Lab</Company>
    <Product>Retro Media Lab</Product>
    <Description>Modern Windows interface for Greaseweazle.</Description>
    <Copyright>Copyright © overthetop78</Copyright>
    <RepositoryUrl>https://github.com/overthetop78/Retro-Media-Lab</RepositoryUrl>
    <SatelliteResourceLanguages>ar-SA;cs-CZ;da-DK;de-DE;el-GR;en-US;es-ES;fi-FI;fr-FR;he-IL;hu-HU;id-ID;it-IT;ja-JP;ko-KR;nb-NO;nl-NL;pl-PL;pt-BR;pt-PT;ro-RO;ru-RU;sv-SE;th-TH;tr-TR;uk-UA;vi-VN;zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RetroMediaLab.Tests" />
    <InternalsVisibleTo Include="RetroMediaLab.LocalEmulationTests" />
    <InternalsVisibleTo Include="RetroMediaLab.LocalDiskImageTests" />
    <ProjectReference Include="..\RetroMediaLab.Infrastructure\RetroMediaLab.Infrastructure.csproj" />
    <ProjectReference Include="..\RetroMediaLab.MediaEngine\RetroMediaLab.MediaEngine.csproj" />
    <ProjectReference Include="..\RetroMediaLab.Emulation\RetroMediaLab.Emulation.csproj" />
    <ProjectReference Include="..\RetroMediaLab.VideoPresentation\RetroMediaLab.VideoPresentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.GameInput" Version="3.5.268" GeneratePathProperty="true" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\DiskDefinitions\built-in.cfg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\RetroMediaLab.MediaEngine\Assets\MechanicalAudio\**\*" Link="Assets\MechanicalAudio\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_GameInput)\redist\GameInputRedist.msi" Link="Runtime\GameInputRedist.msi" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Theme\OS\Editions\Windows31\Assets\ColorSchemes.json" LogicalName="RetroMediaLab.App.Theme.OS.Windows31.ColorSchemes.json" />
    <Content Include="Assets\Controllers\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Input\gamecontrollerdb.txt" LogicalName="RetroMediaLab.App.Assets.Input.gamecontrollerdb.txt" />
    <None Include="Assets\Input\SDL_GameControllerDB.LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\*\*.resx">
      <Culture>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)'))))</Culture>
      <WithCulture>true</WithCulture>
      <ManifestResourceName>RetroMediaLab.App.Resources.%(Filename).$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)'))))</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\*\Emulation\*.resx">
      <Culture>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(Identity)'))))))</Culture>
      <WithCulture>true</WithCulture>
      <ManifestResourceName>RetroMediaLab.App.Resources.%(Filename).$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('%(Identity)'))))))</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\00-Base\*.resx">
      <Culture>
      </Culture>
      <WithCulture>false</WithCulture>
      <ManifestResourceName>RetroMediaLab.App.Resources.%(Filename)</ManifestResourceName>
      <LogicalName>RetroMediaLab.App.Resources.%(Filename).resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\00-Base\Emulation\*.resx">
      <Culture>
      </Culture>
      <WithCulture>false</WithCulture>
      <ManifestResourceName>RetroMediaLab.App.Resources.%(Filename)</ManifestResourceName>
      <LogicalName>RetroMediaLab.App.Resources.%(Filename).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
