<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows95.Views.LogHistoryView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions"  FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/><ResourceDictionary Source="../../../Styles/Windows95Desktop.xaml"/><ResourceDictionary Source="../../../Styles/Windows95Explorer.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="ExportCommand" Header="{l:Loc Common.Export}"/>
    <Separator/>
    <MenuItem Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
  </Menu>
  <DockPanel Margin="6"><ComboBox x:Name="Files" DisplayMemberPath="Name" DockPanel.Dock="Top" Margin="0,0,0,6"/>
   <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Courier New" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
  </DockPanel>
 </DockPanel>
</UserControl>
