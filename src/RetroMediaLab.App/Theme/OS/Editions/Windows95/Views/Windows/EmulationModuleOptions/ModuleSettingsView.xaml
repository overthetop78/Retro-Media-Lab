<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows95.Views.ModuleSettingsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/><ResourceDictionary Source="../../../Styles/Windows95Explorer.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel Margin="8">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <Image Source="{Binding SelectedItem.Image, ElementName=Machines}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0"/>
   <Label Content="{l:Loc Emulation.Configuration.Machine}" Target="{Binding ElementName=Machines}" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox x:Name="Machines" DisplayMemberPath="DisplayName" VerticalAlignment="Center"/>
  </DockPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
   <Button x:Name="CreateAction" Content="{l:Loc Common.Create}" Click="CreateClick" MinWidth="80"/>
   <Button DockPanel.Dock="Right" Content="{l:Loc Common.Close}" Click="CloseClick" MinWidth="80"/>
  </DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox x:Name="Categories" SelectionChanged="CategoryChanged" HorizontalContentAlignment="Stretch"/>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="Fields" MinWidth="380"/></ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
