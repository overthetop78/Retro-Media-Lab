<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows95.Views.TerminalView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/><ResourceDictionary Source="../../../Styles/Windows95Desktop.xaml"/><ResourceDictionary Source="../../../Styles/Windows95Explorer.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="CopyCommand" Header="{l:Loc Common.Copy}"/>
                <Separator/>
                <MenuItem Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
        </Menu>
        <DockPanel Margin="4" Background="Black">
            <TextBox x:Name="Command" Background="Black" Foreground="#C0C0C0" DockPanel.Dock="Top" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0,0,0,1"
                     FontFamily="Courier New" FontSize="11"/>
            <RichTextBox x:Name="Output" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="4"
                         Background="Black"
                         Foreground="#C0C0C0"
                         FontFamily="Courier New" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <RichTextBox.Template><ControlTemplate TargetType="RichTextBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate></RichTextBox.Template>
                <FlowDocument PagePadding="0"/>
            </RichTextBox>
        </DockPanel>
    </DockPanel>
</UserControl>
