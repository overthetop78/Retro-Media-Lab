<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows95.Views.ConversionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../../../Styles/Windows95Desktop.xaml"/>
  <ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="OpenCommand" Header="{l:Loc Options.Themes.OS.Open}"/>
    <MenuItem x:Name="PreviewCommand" Header="{l:Loc Write.VisualizeTracks}"/>
    <Separator/><MenuItem x:Name="ExecuteCommand"/><MenuItem x:Name="MigrationCommand" Header="{l:Loc Migration.Open}"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}">
    <MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
    <MenuItem Header="{l:Loc Profile.Title}"><MenuItem x:Name="SaveProfile" Header="{l:Loc Common.Save}"/><MenuItem x:Name="ResetProfile" Header="{l:Loc Common.Reset}"/></MenuItem>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" BorderBrush="White" BorderThickness="0,1,0,0" Padding="4">
   <DockPanel>
    <Button x:Name="Execute" DockPanel.Dock="Left" MinWidth="90" IsDefault="True" Margin="0,0,8,0"/>
    <Label DockPanel.Dock="Left" Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}"/>
    <ComboBox x:Name="Profiles" MinWidth="160" MaxWidth="320" HorizontalAlignment="Left"/>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="3" Margin="2"><TextBlock x:Name="Operation" TextTrimming="CharacterEllipsis"/></Border>
  <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
   <Grid Margin="8" MinWidth="500">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition MinHeight="150"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Label Content="{l:Loc Conversion.Source}" Target="{Binding ElementName=SourcePath}"/>
     <TextBox x:Name="SourcePath" Grid.Column="1" Margin="0,2,6,2"/>
     <Button x:Name="Browse" Grid.Column="2" Content="{l:Loc Common.Browse}" Margin="0,2"/>
     <Label Grid.Row="1" Content="{l:Loc Conversion.OutputNames}" Target="{Binding ElementName=OutputName}"/>
     <TextBox x:Name="OutputName" Grid.Row="1" Grid.Column="1" Margin="0,2,6,2"/>
     <CheckBox x:Name="Tags" Grid.Row="1" Grid.Column="2" Content="{l:Loc Conversion.AddTags}" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="SourceInformation" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TabControl Grid.Row="2">
     <TabItem Header="{l:Loc Classification.Format}">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Label Content="{l:Loc Classification.Machine}" Target="{Binding ElementName=Machines}"/><ComboBox x:Name="Machines"/></DockPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <TextBlock x:Name="FormatInformation" TextWrapping="Wrap"/>
        <WrapPanel x:Name="Extensions" Margin="0,4,0,0"/>
       </StackPanel>
       <ListBox x:Name="Formats" SelectionChanged="FormatSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </DockPanel>
     </TabItem>
     <TabItem Header="{l:Loc Conversion.Selected}"><ListBox x:Name="SelectedOutputs" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></TabItem>
    </TabControl>
   </Grid>
  </ScrollViewer>
 </DockPanel>
</UserControl>
