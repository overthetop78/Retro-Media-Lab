<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows95.Views.WriteView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Microsoft Sans Serif" FontSize="11" Background="#C0C0C0" Foreground="Black">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="../../../Styles/Windows95Desktop.xaml"/>
   <ResourceDictionary Source="../../../Styles/Windows95Controls.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="OpenCommand" Header="{l:Loc Options.Themes.OS.Open}"/>
    <MenuItem x:Name="WriteCommand"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}">
    <MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
    <MenuItem x:Name="ModifyCommand" Header="{l:Loc Common.Modify}"/>
    <MenuItem x:Name="VisualizeCommand" Header="{l:Loc Write.VisualizeTracks}"/>
    <Separator/>
    <MenuItem Header="{l:Loc Profile.Title}"><MenuItem x:Name="SaveProfile" Header="{l:Loc Common.Save}"/><MenuItem x:Name="ResetProfile" Header="{l:Loc Common.Reset}"/></MenuItem>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" BorderBrush="White" BorderThickness="0,1,0,0" Padding="4">
   <DockPanel>
    <Button x:Name="Execute" DockPanel.Dock="Left" MinWidth="90" IsDefault="True" Margin="0,0,8,0"/>
    <Label DockPanel.Dock="Left" Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}"/>
    <ComboBox x:Name="Profiles" MinWidth="160" MaxWidth="320" HorizontalAlignment="Left"/>
   </DockPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" BorderBrush="#808080" BorderThickness="1,1,0,0" Padding="3" Margin="2"><TextBlock x:Name="Hardware" TextTrimming="CharacterEllipsis"/></Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
   <Grid Margin="8" MinWidth="440">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Label Content="{l:Loc Write.Source}" Target="{Binding ElementName=SourcePath}"/>
     <TextBox x:Name="SourcePath" Grid.Column="1" Margin="0,2,6,2"/>
     <Button x:Name="Browse" Grid.Column="2" Content="{l:Loc Common.Browse}" Margin="0,2"/>
    </Grid>
    <Label Grid.Row="1" Content="{l:Loc Write.Detected}"/>
    <Border Grid.Row="2" BorderBrush="#808080" BorderThickness="1,1,0,0" Margin="0,2,0,8" Background="White" MinHeight="100">
     <Border BorderBrush="White" BorderThickness="0,0,1,1" Padding="8">
      <StackPanel>
       <TextBlock x:Name="Detection" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <ComboBox x:Name="Formats"/>
      </StackPanel>
     </Border>
    </Border>
    <TextBlock x:Name="Verification" Grid.Row="3" TextWrapping="Wrap" Margin="0,0,0,4">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{l:Loc Write.VerifyOn}"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Text" Value="{l:Loc Write.VerifyOff}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </ScrollViewer>
 </DockPanel>
</UserControl>
