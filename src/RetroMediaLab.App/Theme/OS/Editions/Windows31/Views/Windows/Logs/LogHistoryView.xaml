<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.LogHistoryView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31">
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="ExportCommand" Header="{l:Loc Common.Export}"/>
    <Separator/>
    <MenuItem Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
  </Menu>
  <Grid Margin="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox x:Name="Files" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   <TextBox x:Name="Output" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
    FontFamily="{DynamicResource Windows31FixedFont}" FontSize="{x:Static w:Windows31Metrics.FixedFontSize}"
    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
  </Grid>
 </DockPanel>
</UserControl>
