<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.ModuleSettingsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
 <DockPanel Margin="8">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <Image Source="{Binding SelectedItem.Image, ElementName=Machines}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
   <TextBlock Text="{l:Loc Emulation.Configuration.Machine}" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox x:Name="Machines" DisplayMemberPath="DisplayName" VerticalAlignment="Center"/>
  </DockPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
   <Button x:Name="CreateAction" Content="{l:Loc Common.Create}" Click="CreateClick"/>
   <Button DockPanel.Dock="Right" Content="{l:Loc Common.Close}" Click="CloseClick"/>
  </DockPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox x:Name="Categories" SelectionChanged="CategoryChanged" HorizontalContentAlignment="Stretch"/>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="Fields" MinWidth="420"/></ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
