<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.FileSelectionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Label x:Name="NameLabel" Content="{l:Loc Read.FileName}" Target="{Binding ElementName=NameField}" Padding="0,0,0,4"/>
  <TextBox x:Name="NameField" Grid.Row="1" Margin="0,0,0,6" TextChanged="OnNameChanged"/>
  <ListBox x:Name="Files" Grid.Row="2" DisplayMemberPath="Name" SelectionChanged="OnFileSelected" MouseDoubleClick="OnFileDoubleClick"/>
  <Label x:Name="TypesLabel" Grid.Row="3" Content="{l:Loc FileDialog.FileTypes}" Target="{Binding ElementName=Types}" Padding="0,8,0,4"/>
  <ComboBox x:Name="Types" Grid.Row="4" DisplayMemberPath="Name" SelectionChanged="OnFilterSelected"/>
  <Label x:Name="FolderLabel" Grid.Column="2" Content="{l:Loc FileDialog.Directories}" Target="{Binding ElementName=Folders}" Padding="0,0,0,4"/>
  <TextBlock x:Name="CurrentPath" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
  <ListBox x:Name="Folders" Grid.Column="2" Grid.Row="2" SelectionChanged="OnFolderSelected" MouseDoubleClick="OnFolderDoubleClick">
   <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
    <Image Source="{Binding Image}" Width="16" Height="16" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,4,0"/>
    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Label x:Name="DriveLabel" Grid.Column="2" Grid.Row="3" Content="{l:Loc FileDialog.Drives}" Target="{Binding ElementName=Drives}" Padding="0,8,0,4"/>
  <ComboBox x:Name="Drives" Grid.Column="2" Grid.Row="4" DisplayMemberPath="Name" SelectionChanged="OnDriveSelected"/>
  <StackPanel Grid.Column="4" Grid.RowSpan="5" MinWidth="80">
   <Button x:Name="Accept" Content="{l:Loc Common.OK}" IsDefault="True" Click="OnAccept"/>
   <Button x:Name="Cancel" Content="{l:Loc Common.Cancel}" Margin="0,6,0,0" Click="OnCancel"/>
   <CheckBox x:Name="ReadOnly" Content="{l:Loc Emulation.Storage.ReadOnly}" Margin="0,14,0,0" Checked="OnReadOnlyChanged" Unchecked="OnReadOnlyChanged"/>
  </StackPanel>
  <TextBlock x:Name="Error" Grid.Row="5" Grid.ColumnSpan="5" Margin="0,8,0,0" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
