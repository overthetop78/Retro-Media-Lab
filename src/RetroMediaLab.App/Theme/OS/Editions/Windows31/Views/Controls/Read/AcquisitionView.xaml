<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.AcquisitionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="BrowseCommand" Header="{l:Loc Read.DestinationFolder}"/>
                <MenuItem x:Name="ExecuteCommand"/>
                <Separator/>
                <MenuItem x:Name="ExploreCommand" Header="{l:Loc Read.OpenExplore}" Click="ExploreClick"/>
                <MenuItem x:Name="VisualizeCommand" Header="{l:Loc Read.OpenVisualize}" Click="VisualizeClick"/>
                <Separator/>
                <MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
            <MenuItem Header="{l:Loc Menu.Options}">
                <MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
                <MenuItem Header="{l:Loc Profile.Title}">
                    <MenuItem x:Name="SaveProfile" Header="{l:Loc Common.Save}"/>
                    <MenuItem x:Name="ResetProfile" Header="{l:Loc Common.Reset}"/>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonShadow}}" BorderThickness="0,1,0,0" Padding="6,3">
            <TextBlock x:Name="Hardware" TextTrimming="CharacterEllipsis"/>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="10,4,10,8">
            <Button x:Name="Execute" DockPanel.Dock="Right" MinWidth="100" Margin="12,0,0,0" IsDefault="True"/>
            <Label Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}"/>
            <ComboBox x:Name="Profiles"/>
        </DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="10,6" MinWidth="520">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="60"/></Grid.RowDefinitions>
                <TabControl x:Name="CaptureMode" Margin="0,0,0,10">
                    <TabItem x:Name="Raw" Header="{l:Loc Read.RawScp}">
                        <DockPanel Margin="8,10">
                            <CheckBox x:Name="RevolutionsEnabled" Content="{l:Loc Read.Revolutions}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="Revolutions" Width="80" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="Known" Header="{l:Loc Read.KnownFormat}">
                        <Grid Margin="8,6,8,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Label Content="{l:Loc Classification.Machine}" Target="{Binding ElementName=Family}"/>
                            <Label Grid.Column="1" Content="{l:Loc Classification.Format}" Target="{Binding ElementName=Format}"/>
                            <Label Grid.Column="2" Content="{l:Loc Read.Extension}" Target="{Binding ElementName=Extension}"/>
                            <ComboBox x:Name="Family" Grid.Row="1" Margin="0,0,6,0"/>
                            <ComboBox x:Name="Format" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0"/>
                            <ComboBox x:Name="Extension" Grid.Row="1" Grid.Column="2"/>
                        </Grid>
                    </TabItem>
                </TabControl>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Label Content="{l:Loc Read.Folder}" Target="{Binding ElementName=Folder}"/>
                    <TextBox x:Name="Folder" Grid.Column="1" Margin="6,2"/>
                    <Button x:Name="Browse" Grid.Column="2" Content="{l:Loc Common.Browse}" Margin="2"/>
                    <Label Grid.Row="1" Content="{l:Loc Read.FileName}" Target="{Binding ElementName=FileName}"/>
                    <TextBox x:Name="FileName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,2"/>
                </Grid>
                <DockPanel Grid.Row="2">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="Explore" Content="{l:Loc Read.OpenExplore}" Click="ExploreClick" Margin="4,0"/>
                            <Button x:Name="Visualize" Content="{l:Loc Read.OpenVisualize}" Click="VisualizeClick"/>
                        </StackPanel>
                        <Label Content="{l:Loc Logs.History}"/>
                    </DockPanel>
                    <ListBox x:Name="History" SelectionMode="Single" MouseDoubleClick="HistoryDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2" ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{l:Loc Status.Running}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Text" Value="{l:Loc Status.Success}"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
