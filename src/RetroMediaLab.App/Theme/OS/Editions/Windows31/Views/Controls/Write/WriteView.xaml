<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.WriteView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="OpenCommand" Header="{l:Loc Options.Themes.OS.Open}"/>
                <Separator/>
                <MenuItem x:Name="WriteCommand"/>
                <Separator/>
                <MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
            <MenuItem Header="{l:Loc Menu.Options}">
                <MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
                <MenuItem x:Name="ModifyCommand" Header="{l:Loc Common.Modify}"/>
                <MenuItem x:Name="VisualizeCommand" Header="{l:Loc Write.VisualizeTracks}"/>
                <Separator/>
                <MenuItem Header="{l:Loc Profile.Title}">
                    <MenuItem x:Name="SaveProfile" Header="{l:Loc Common.Save}"/>
                    <MenuItem x:Name="ResetProfile" Header="{l:Loc Common.Reset}"/>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonShadow}}" Padding="6,3">
            <TextBlock x:Name="Hardware" TextTrimming="CharacterEllipsis"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="12,10" MinWidth="420">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Content="{l:Loc Write.Source}" Target="{Binding ElementName=SourcePath}" VerticalAlignment="Center"/>
                <TextBox x:Name="SourcePath" Grid.Column="1" Margin="6,2" VerticalContentAlignment="Center"/>
                <Button x:Name="Browse" Grid.Column="2" Content="{l:Loc Common.Browse}" Margin="4,2,0,2"/>
                <Label Grid.Row="1" Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}" VerticalAlignment="Center"/>
                <ComboBox x:Name="Profiles" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,6,0,6"/>
                <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="{l:Loc Write.Detected}" Margin="0,8,0,0" Padding="8">
                    <StackPanel>
                        <TextBlock x:Name="Detection" TextWrapping="Wrap" MinHeight="30"/>
                        <ComboBox x:Name="Formats" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
                <TextBlock x:Name="Verification" Grid.Row="3" Grid.ColumnSpan="3" Margin="4,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{l:Loc Write.VerifyOn}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter Property="Text" Value="{l:Loc Write.VerifyOff}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="Execute" Grid.Row="5" Grid.Column="2" MinWidth="100" Margin="4,0,0,0" IsDefault="True"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
