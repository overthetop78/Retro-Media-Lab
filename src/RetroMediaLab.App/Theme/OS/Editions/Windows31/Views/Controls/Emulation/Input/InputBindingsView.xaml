<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.InputBindingsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
 <DockPanel Margin="8">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBlock Text="{l:Loc Emulation.Input.Binding.Search}" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox x:Name="Search"/>
  </DockPanel>
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <Button x:Name="AssignAction" Content="{l:Loc Emulation.Input.Assign}" Click="Assign" Margin="0,0,6,4"/>
   <Button Content="{l:Loc Common.Delete}" Click="Clear" Margin="0,0,6,4"/>
   <Button Content="{l:Loc Emulation.Input.Binding.RestoreDefaults}" Click="RestoreDefaults" Margin="0,0,6,4"/>
   <Button Content="{l:Loc Emulation.Input.Binding.ClearConflicts}" Click="ClearConflicts" Margin="0,0,6,4"/>
  </WrapPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc Emulation.Input.Binding.LabelLegend}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*" MinWidth="85"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="TargetHeader"/>
   <TextBlock Grid.Column="1" Text="{l:Loc Emulation.Input.Binding.Label}"/>
   <TextBlock Grid.Column="2" Text="{l:Loc Emulation.Input.Binding.LabelState}"/>
  </Grid>
  <ListBox x:Name="Rows" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto">
   <ListBox.ItemTemplate><DataTemplate>
    <Grid Margin="3" MinWidth="480">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*" MinWidth="85"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"/>
     <ItemsControl Grid.Column="1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" ItemsSource="{Binding BindingParts}" Margin="0,0,8,0" VerticalAlignment="Center">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Text}"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="+" Visibility="{Binding SeparatorVisibility}" Margin="4,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Grid.Column="2" Text="{Binding StateText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </Grid>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</UserControl>
