<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.VisualizationView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="OpenCommand" Header="{l:Loc Visual.OpenImage}"/>
                <Separator/>
                <MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
            <MenuItem Header="{l:Loc Menu.Options}">
                <MenuItem x:Name="ResetCommand" Header="{l:Loc Common.Reset}"/>
                <MenuItem x:Name="LinkZoomCommand" Header="{l:Loc Visual.LinkZoom}" IsCheckable="True"/>
                <MenuItem x:Name="ClassificationCommand" Header="{l:Loc Common.Advanced}" Click="ClassificationClick"/>
                <Separator/>
                <MenuItem x:Name="InspectorCommand" Header="{l:Loc Visual.Inspector}" Click="InspectorClick"/>
            </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Top" Margin="6,4">
            <TextBlock x:Name="FileName" TextTrimming="CharacterEllipsis" FontWeight="Bold"/>
            <TextBlock x:Name="Summary" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <WrapPanel x:Name="DocumentChoices" Margin="0,4,0,0"/>
        </StackPanel>
        <Border x:Name="Recognition" DockPanel.Dock="Bottom" Padding="6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonShadow}}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="RecognitionStage"/>
                <ProgressBar x:Name="RecognitionProgress" Height="14" Margin="0,4"/>
                <TextBlock x:Name="RecognitionDetail" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
        <ItemsControl x:Name="Legend" DockPanel.Dock="Bottom" Margin="6,2">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <Rectangle Width="8" Height="8" Fill="{Binding Value}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Key}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="OverviewRow" Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="DrawingArea" Margin="6,0,6,4"/>
            <ContentControl x:Name="OverviewHost" Grid.Row="1" MaxHeight="100" Margin="2,0,2,2" HorizontalContentAlignment="Stretch"/>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Visual.NoFile}" HorizontalAlignment="Center"/>
                <Button x:Name="EmptyOpen" Content="{l:Loc Visual.OpenImage}" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
