<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.CoreManagementView" x:ClassModifier="internal" x:Name="Panel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31">
 <GroupBox Header="{l:Loc Emulation.Core.Emulator}" Margin="0,0,0,10">
  <StackPanel>
   <DockPanel Margin="0,0,0,6"><TextBlock x:Name="Installed" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"/><ComboBox x:Name="Emulators"/></DockPanel>
   <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <WrapPanel><Button x:Name="Search" Content="{l:Loc Emulation.Core.NameSearch}" Margin="0,0,6,6"/><Button x:Name="Download" Content="{l:Loc Emulation.Core.NameDownload}" Margin="0,0,6,6"/><Button x:Name="Cancel" Content="{l:Loc Common.Cancel}" Margin="0,0,0,6"/></WrapPanel>
   <ComboBox x:Name="Versions" Margin="0,0,0,8"/>
   <ProgressBar x:Name="Progress" Height="14" Margin="0,0,0,8"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonText}}">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StatusIsError, ElementName=Panel}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </StackPanel>
 </GroupBox>
</UserControl>
