<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Windows31Frame"
             x:ClassModifier="internal" x:Name="Frame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions"
             FontFamily="{DynamicResource Windows31BodyFont}" FontSize="{x:Static w:Windows31Metrics.BodyFontSize}"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Aliased"
             TextElement.Foreground="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonText}}"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             Focusable="True" PreviewMouseDown="ActivateFrame" PreviewKeyDown="FrameKeyDown"
             PreviewMouseMove="FrameMouseMove" PreviewMouseLeftButtonUp="FrameMouseUp" LostMouseCapture="FrameLostCapture" MouseLeave="FrameMouseLeave">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Styles/Windows31Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="CaptionCommand" TargetType="Button">
            <Setter Property="Width" Value="{x:Static w:Windows31Metrics.CaptionCommandWidth}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonFace}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.WindowFrame}}" BorderThickness="1">
                            <Border x:Name="Relief" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonHighlight}}" BorderThickness="1,1,0,0">
                                <Border x:Name="Inset" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonShadow}}" BorderThickness="0,0,1,1">
                                    <w:Windows31ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Relief" Property="BorderBrush" Value="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonShadow}}"/>
                                <Setter TargetName="Inset" Property="BorderBrush" Value="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonHighlight}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="FrameBorder" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.WindowFrame}}" BorderThickness="1" Background="{DynamicResource {x:Static w:Windows31PaletteResources.InactiveBorder}}">
        <Border BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonHighlight}}" BorderThickness="1,1,0,0">
            <Border BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonShadow}}" BorderThickness="0,0,1,1" Padding="{x:Static w:Windows31Metrics.FramePadding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Static w:Windows31Metrics.CaptionRowHeight}"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Caption" Background="{DynamicResource {x:Static w:Windows31PaletteResources.InactiveCaption}}" MouseLeftButtonDown="CaptionMouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SystemBox" Style="{StaticResource CaptionCommand}" Click="SystemClick" MouseDoubleClick="SystemDoubleClick">
                            <Border Width="9" Height="3" BorderThickness="1" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.WindowFrame}}" Background="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonHighlight}}"/>
                        </Button>
                        <TextBlock FontFamily="{DynamicResource Windows31CaptionFont}" FontSize="{x:Static w:Windows31Metrics.CaptionFontSize}" FontWeight="Bold" x:Name="CaptionText" Grid.Column="1" Text="{Binding Title, ElementName=Frame}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Ideal"/>
                        <Button x:Name="IconifyCommand" Grid.Column="2" Style="{StaticResource CaptionCommand}" ToolTip="{l:Loc Options.Themes.Minimize}" Click="IconifyClick">
                            <Path Data="M 0,0 L 8,0 4,4 Z" Fill="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonText}}"/>
                        </Button>
                        <Button x:Name="MaximizeCommand" Grid.Column="3" Style="{StaticResource CaptionCommand}" ToolTip="{l:Loc Options.Themes.MaximizeRestore}" Click="MaximizeClick">
                            <Path x:Name="MaximizeGlyph" Data="M 0,4 L 8,4 4,0 Z" Fill="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonText}}"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonFace}}" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.WindowFrame}}" BorderThickness="1">
                        <ContentControl x:Name="DocumentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Border>
</UserControl>
