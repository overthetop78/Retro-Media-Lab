<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.ConversionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="OpenCommand" Header="{l:Loc Options.Themes.OS.Open}"/>
                <MenuItem x:Name="PreviewCommand" Header="{l:Loc Write.VisualizeTracks}"/>
                <Separator/>
                <MenuItem x:Name="ExecuteCommand"/>
                <MenuItem x:Name="MigrationCommand" Header="{l:Loc Migration.Open}"/>
                <Separator/>
                <MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
            <MenuItem Header="{l:Loc Menu.Options}">
                <MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/>
                <MenuItem Header="{l:Loc Profile.Title}">
                    <MenuItem x:Name="SaveProfile" Header="{l:Loc Common.Save}"/>
                    <MenuItem x:Name="ResetProfile" Header="{l:Loc Common.Reset}"/>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource {x:Static w:Windows31PaletteResources.ButtonShadow}}" BorderThickness="0,1,0,0" Padding="6,3">
            <TextBlock x:Name="Operation" TextTrimming="CharacterEllipsis"/>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="10,0,10,8">
            <Button x:Name="Execute" DockPanel.Dock="Right" MinWidth="100" Margin="12,0,0,0" IsDefault="True"/>
            <Label Content="{l:Loc Profile.Title}" Target="{Binding ElementName=Profiles}"/>
            <ComboBox x:Name="Profiles"/>
        </DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="10" MinWidth="540">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Label Content="{l:Loc Conversion.Source}" Target="{Binding ElementName=SourcePath}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SourcePath" Grid.Column="1" Margin="6,2"/>
                    <Button x:Name="Browse" Grid.Column="2" Content="{l:Loc Common.Browse}" Margin="2"/>
                    <Label Grid.Row="1" Content="{l:Loc Conversion.OutputNames}" Target="{Binding ElementName=OutputName}" VerticalAlignment="Center"/>
                    <TextBox x:Name="OutputName" Grid.Row="1" Grid.Column="1" Margin="6,4"/>
                    <CheckBox x:Name="Tags" Grid.Row="1" Grid.Column="2" Content="{l:Loc Conversion.AddTags}" Margin="6,4,2,4"/>
                </Grid>
                <TextBlock x:Name="SourceInformation" Grid.Row="1" Grid.ColumnSpan="2" Margin="4,4,0,8" TextWrapping="Wrap"/>
                <DockPanel Grid.Row="2" Margin="0,0,6,4">
                    <Label Content="{l:Loc Classification.Machine}" Target="{Binding ElementName=Machines}"/>
                    <ComboBox x:Name="Machines" MinWidth="130"/>
                </DockPanel>
                <Label Grid.Row="2" Grid.Column="1" Content="{l:Loc Conversion.Selected}" Margin="6,0,0,0"/>
                <ListBox x:Name="Formats" Grid.Row="3" Margin="0,0,6,0" SelectionChanged="FormatSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                <ListBox x:Name="SelectedOutputs" Grid.Row="3" Grid.Column="1" Margin="6,0,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Header="{l:Loc Read.Extension}" Margin="0,8,0,8" Padding="6">
                    <StackPanel>
                        <TextBlock x:Name="FormatInformation" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="Extensions" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
