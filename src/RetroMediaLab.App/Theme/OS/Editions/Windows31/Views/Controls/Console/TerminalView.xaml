<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.Windows31.Views.TerminalView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.Windows31"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{l:Loc Options.Themes.OS.File}">
                <MenuItem x:Name="CopyCommand" Header="{l:Loc Common.Copy}"/>
                <Separator/>
                <MenuItem Header="{l:Loc Common.Close}" Click="CloseClick"/>
            </MenuItem>
        </Menu>
        <DockPanel Margin="4" Background="{DynamicResource {x:Static w:Windows31PaletteResources.Window}}">
            <TextBox x:Name="Command" DockPanel.Dock="Top" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0,0,0,1"
                     FontFamily="{DynamicResource Windows31FixedFont}" FontSize="{x:Static w:Windows31Metrics.FixedFontSize}"/>
            <RichTextBox x:Name="Output" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Padding="4"
                         Background="{DynamicResource {x:Static w:Windows31PaletteResources.Window}}"
                         Foreground="{DynamicResource {x:Static w:Windows31PaletteResources.WindowText}}"
                         FontFamily="{DynamicResource Windows31FixedFont}" FontSize="{x:Static w:Windows31Metrics.FixedFontSize}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <RichTextBox.Template><ControlTemplate TargetType="RichTextBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate></RichTextBox.Template>
                <FlowDocument PagePadding="0"/>
            </RichTextBox>
        </DockPanel>
    </DockPanel>
</UserControl>
