<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.WindowsXP.Views.FirmwareSelectionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <DockPanel>
  <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource WindowsXP.Face}">
   <ToolBar Background="{DynamicResource WindowsXP.Face}">
    <Button x:Name="Open" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}">
     <StackPanel Orientation="Horizontal"><Image x:Name="FolderIcon" Width="24" Height="24" Margin="0,0,5,0"/>
      <TextBlock Text="{l:Loc Emulation.Firmware.Rom.OpenFolder}" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <Separator/>
    <Button x:Name="Refresh" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}">
     <StackPanel Orientation="Horizontal"><Image x:Name="RefreshIcon" Width="24" Height="24" Margin="0,0,5,0"/>
      <TextBlock Text="{l:Loc Common.Refresh}" VerticalAlignment="Center"/></StackPanel>
    </Button>
   </ToolBar>
  </ToolBarTray>
  <TextBlock x:Name="Destination" DockPanel.Dock="Top" FontWeight="Bold" Margin="8" TextWrapping="Wrap"/>
  <StackPanel DockPanel.Dock="Bottom" Margin="8">
   <TextBox x:Name="PathValue" IsReadOnly="True" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="Save" Content="{l:Loc Common.Save}" IsDefault="True" MinWidth="85" Margin="0,0,8,0"/>
    <Button x:Name="Cancel" Content="{l:Loc Common.Cancel}" MinWidth="85"/>
   </StackPanel>
  </StackPanel>
  <Grid Margin="8,0">
   <ListView x:Name="Candidates" ScrollViewer.HorizontalScrollBarVisibility="Auto" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}">
    <ListView.View><GridView AllowsColumnReorder="False">
     <GridViewColumn Header="{l:Loc Explorer.Name}" DisplayMemberBinding="{Binding Name}" Width="210"/>
     <GridViewColumn Header="{l:Loc Read.FileName}" DisplayMemberBinding="{Binding File}" Width="160"/>
     <GridViewColumn Header="{l:Loc Emulation.Input.Binding.LabelState}" DisplayMemberBinding="{Binding Compatibility}" Width="145"/>
     <GridViewColumn Header="{l:Loc Emulation.Firmware}" DisplayMemberBinding="{Binding Destination}" Width="145"/>
    </GridView></ListView.View>
   </ListView>
   <TextBlock x:Name="Empty" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="12"/>
  </Grid>
 </DockPanel>
</UserControl>
