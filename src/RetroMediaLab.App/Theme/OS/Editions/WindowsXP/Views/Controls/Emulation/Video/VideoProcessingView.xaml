<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.WindowsXP.Views.VideoProcessingView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <DockPanel Margin="8">
  <ComboBox x:Name="Pages" DockPanel.Dock="Top" DisplayMemberPath="Label" SelectionChanged="PageChanged" Margin="0,0,0,12"/>
  <StackPanel x:Name="ShaderLoading" DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{l:Loc Emulation.Video.Shader.Loading}"/>
   <ProgressBar IsIndeterminate="True" Height="18" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="400"><StackPanel x:Name="Fields"/></ScrollViewer>
 </DockPanel>
</UserControl>
