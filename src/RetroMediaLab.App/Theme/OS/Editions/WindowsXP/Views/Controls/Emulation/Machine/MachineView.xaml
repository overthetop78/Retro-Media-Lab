<common:EmulationMachinePresentation x:Class="RetroMediaLab.App.Theme.OS.Editions.WindowsXP.Views.MachineView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:common="clr-namespace:RetroMediaLab.App.Theme.Common" xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions"
 xmlns:v="clr-namespace:RetroMediaLab.App.Theme.OS.Editions.WindowsXP.Views"
 FontFamily="Tahoma" FontSize="11" Background="{DynamicResource WindowsXP.Face}" Foreground="Black" UseLayoutRounding="True">
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Emulation.Configuration.Machine}">
    <MenuItem x:Name="PowerCommand" Header="{l:Loc Emulation.Shortcut.Power}"/>
    <MenuItem x:Name="PauseCommand" Header="{l:Loc Emulation.Shortcut.PauseResume}"/>
    <Separator/><MenuItem x:Name="SoftResetCommand" Header="{l:Loc Emulation.Shortcut.SoftReset}"/><MenuItem x:Name="HardResetCommand" Header="{l:Loc Emulation.Shortcut.HardReset}"/>
    <Separator/><MenuItem x:Name="QuickSaveCommand" Header="{l:Loc Emulation.Shortcut.QuickSave}"/><MenuItem x:Name="QuickLoadCommand" Header="{l:Loc Emulation.Shortcut.QuickLoad}"/>
    <Separator/><MenuItem x:Name="AudioCommand" Header="{l:Loc Emulation.Shortcut.Mute}"/><MenuItem x:Name="PointerCommand" Header="{l:Loc Emulation.Controller.Action.SwitchJoystickMouse}"/><MenuItem x:Name="CoreCommand" Header="{l:Loc Emulation.Core.NameOptions}"/>
   </MenuItem>
   <MenuItem x:Name="SupportsMenu" Header="{l:Loc Emulation.Tab.Storage}" IsEnabled="False"/>
   <MenuItem Header="{l:Loc Emulation.Tab.Video}"><MenuItem x:Name="CaptureCommand" Header="{l:Loc Emulation.Shortcut.Screenshot}"/><MenuItem x:Name="FullscreenCommand" Header="{l:Loc Emulation.Shortcut.Fullscreen}"/></MenuItem>
  </Menu>
  <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource WindowsXP.Face}">
   <ToolBar Background="{DynamicResource WindowsXP.Face}">
    <v:WindowsXPCommandToggleButton x:Name="PowerToolbar" Style="{DynamicResource {x:Static ToolBar.ToggleButtonStyleKey}}" Content="{l:Loc Emulation.Shortcut.Power}" Padding="8,4"/>
    <v:WindowsXPCommandToggleButton x:Name="PauseToolbar" Style="{DynamicResource {x:Static ToolBar.ToggleButtonStyleKey}}" Content="{l:Loc Emulation.Shortcut.PauseResume}" Padding="8,4"/>
    <Separator/>
    <Button x:Name="ResetToolbar" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" Content="{l:Loc Emulation.Shortcut.SoftReset}" Padding="8,4"/>
    <Button x:Name="CoreToolbar" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" Content="{l:Loc Emulation.Core.NameOptions}" Padding="8,4"/>
   </ToolBar>
  </ToolBarTray>
  <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource WindowsXP.Face}">
   <StatusBarItem><TextBlock x:Name="Renderer"/></StatusBarItem>
   <Separator/><StatusBarItem><TextBlock x:Name="Status" TextTrimming="CharacterEllipsis"/></StatusBarItem>
   <StatusBarItem HorizontalAlignment="Right"><StackPanel Orientation="Horizontal">
    <TextBlock Text="{l:Loc Emulation.Tab.Controller}" Margin="6,0,4,0"/><Ellipse x:Name="ControllerLight" Width="8" Height="8"/>
    <TextBlock Text="{l:Loc Emulation.Tab.Mouse}" Margin="8,0,4,0"/><Ellipse x:Name="PointerLight" Width="8" Height="8"/>
   </StackPanel></StatusBarItem>
  </StatusBar>
  <GroupBox x:Name="DeviceBand" DockPanel.Dock="Bottom" Header="{l:Loc Emulation.Tab.Storage}" Margin="5,0,5,5" MaxHeight="140" Visibility="Collapsed">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <WrapPanel x:Name="Devices" ItemWidth="150" ItemHeight="32"/>
   </ScrollViewer>
  </GroupBox>
  <Grid x:Name="DisplayArea" Background="Black" Margin="5">
   <Border x:Name="ScreenArea" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
    <Grid x:Name="VideoArea" Background="Black">
     <Border x:Name="Loading" Panel.ZIndex="1" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12" Background="{DynamicResource WindowsXP.Face}">
      <StackPanel><TextBlock Text="{l:Loc Emulation.Video.Shader.Loading}"/><ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"/></StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
 </DockPanel>
</common:EmulationMachinePresentation>
