<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.WindowsXP.Views.VisualizationView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}"><MenuItem x:Name="OpenCommand" Header="{l:Loc Visual.OpenImage}"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/></MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}">
    <MenuItem x:Name="ResetCommand" Header="{l:Loc Common.Reset}"/>
    <MenuItem x:Name="LinkZoomCommand" Header="{l:Loc Visual.LinkZoom}" IsCheckable="True"/>
    <MenuItem x:Name="ClassificationCommand" Header="{l:Loc Common.Advanced}" Click="ClassificationClick"/>
    <Separator/><MenuItem x:Name="InspectorCommand" Header="{l:Loc Visual.Inspector}" Click="InspectorClick"/>
   </MenuItem>
  </Menu>
  <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource WindowsXP.Face}">
   <ToolBar Background="{DynamicResource WindowsXP.Face}">
    <Button x:Name="OpenToolbar" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}">
     <StackPanel Orientation="Horizontal"><Image x:Name="OpenIcon" Width="24" Height="24" Margin="0,0,5,0"/>
      <TextBlock Text="{l:Loc Visual.OpenImage}" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <Button x:Name="ResetToolbar" Content="{l:Loc Common.Reset}" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}"/>
    <Separator/>
    <Button x:Name="InspectorToolbar" Style="{DynamicResource {x:Static ToolBar.ButtonStyleKey}}" Click="InspectorClick">
     <StackPanel Orientation="Horizontal"><Image x:Name="InspectorIcon" Width="24" Height="24" Margin="0,0,5,0"/>
      <TextBlock Text="{l:Loc Visual.Inspector}" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <Separator/><CheckBox x:Name="LinkZoomToolbar" Content="{l:Loc Visual.LinkZoom}" VerticalAlignment="Center"/>
   </ToolBar>
  </ToolBarTray>
  <Border DockPanel.Dock="Top" Background="White" Padding="10,6">
   <StackPanel><TextBlock x:Name="FileName" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="Summary" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
   </StackPanel>
  </Border>
  <WrapPanel x:Name="DocumentChoices" DockPanel.Dock="Top" Margin="6"/>
  <Border x:Name="Recognition" DockPanel.Dock="Bottom" Padding="10" Visibility="Collapsed">
   <StackPanel><TextBlock x:Name="RecognitionStage"/>
    <ProgressBar x:Name="RecognitionProgress" Height="16" Margin="0,5"/>
    <TextBlock x:Name="RecognitionDetail" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <ItemsControl x:Name="Legend" DockPanel.Dock="Bottom" Margin="10,4">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,12,3">
    <Rectangle Width="8" Height="8" Fill="{Binding Value}" Margin="0,0,5,0"/><TextBlock Text="{Binding Key}"/>
   </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Grid Margin="6,0,6,4">
   <Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="OverviewRow" Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="DrawingArea"/>
   <ContentControl x:Name="OverviewHost" Grid.Row="1" MaxHeight="120" Margin="0,6,0,0" HorizontalContentAlignment="Stretch"/>
   <Border x:Name="EmptyState" Grid.RowSpan="2" Background="{DynamicResource WindowsXP.Face}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{l:Loc Visual.NoFile}" HorizontalAlignment="Center"/>
     <Button x:Name="EmptyOpen" Content="{l:Loc Visual.OpenImage}" Margin="0,12,0,0"/></StackPanel>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>
