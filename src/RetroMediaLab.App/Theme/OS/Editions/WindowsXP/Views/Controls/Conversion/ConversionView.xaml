<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.WindowsXP.Views.ConversionView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="{l:Loc Options.Themes.OS.File}">
    <MenuItem x:Name="OpenCommand" Header="{l:Loc Options.Themes.OS.Open}"/>
    <MenuItem x:Name="PreviewCommand" Header="{l:Loc Write.VisualizeTracks}"/><Separator/>
    <MenuItem x:Name="ExecuteCommand"/><MenuItem x:Name="MigrationCommand" Header="{l:Loc Migration.Open}"/>
    <Separator/><MenuItem x:Name="CloseCommand" Header="{l:Loc Common.Close}" Click="CloseClick"/>
   </MenuItem>
   <MenuItem Header="{l:Loc Menu.Options}"><MenuItem x:Name="AdvancedCommand" Header="{l:Loc Common.Advanced}" Click="AdvancedClick"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Background="White" Padding="12,10">
   <DockPanel><Image x:Name="PageIcon" Width="32" Height="32" Margin="0,0,10,0" DockPanel.Dock="Left"/>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="{l:Loc Tab.Convert}" FontSize="16" FontWeight="Bold"/>
     <TextBlock x:Name="SourceInformation" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <DockPanel DockPanel.Dock="Bottom" Margin="12,8">
   <Button x:Name="Execute" DockPanel.Dock="Right" MinWidth="100" IsDefault="True" Margin="10,0,0,0"/>
   <TextBlock x:Name="Operation" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <TabControl Margin="12,10,12,0">
   <TabItem Header="{l:Loc Conversion.Source}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
     <StackPanel Margin="12" MinWidth="440">
      <GroupBox Header="{l:Loc Conversion.Source}" Margin="0,0,0,12">
       <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SourcePath" Margin="0,0,8,0"/>
        <Button x:Name="Browse" Grid.Column="1" Content="{l:Loc Common.Browse}"/>
       </Grid>
      </GroupBox>
      <GroupBox Header="{l:Loc Conversion.OutputNames}" Margin="0,0,0,12">
       <StackPanel Margin="4"><TextBox x:Name="OutputName" Margin="0,0,0,8"/>
        <CheckBox x:Name="Tags" Content="{l:Loc Conversion.AddTags}"/>
       </StackPanel>
      </GroupBox>
      <GroupBox Header="{l:Loc Profile.Title}">
       <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="Profiles" Margin="0,0,8,0"/>
        <Button x:Name="SaveProfile" Grid.Column="1" Content="{l:Loc Common.Save}" Margin="0,0,8,0"/>
        <Button x:Name="ResetProfile" Grid.Column="2" Content="{l:Loc Common.Reset}"/>
       </Grid>
      </GroupBox>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{l:Loc Classification.Format}">
    <DockPanel Margin="12">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Label Content="{l:Loc Classification.Machine}" Target="{Binding ElementName=Machines}" Margin="0,0,8,0"/>
      <ComboBox x:Name="Machines"/>
     </DockPanel>
     <GroupBox DockPanel.Dock="Bottom" Header="{l:Loc Read.Extension}" Margin="0,10,0,0">
      <StackPanel Margin="4"><TextBlock x:Name="FormatInformation" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <WrapPanel x:Name="Extensions"/>
      </StackPanel>
     </GroupBox>
     <ListBox x:Name="Formats" SelectionChanged="FormatSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="{l:Loc Conversion.Selected}"><ListBox x:Name="SelectedOutputs" Margin="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
