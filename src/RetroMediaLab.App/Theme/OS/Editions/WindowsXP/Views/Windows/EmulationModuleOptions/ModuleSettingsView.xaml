<UserControl x:Class="RetroMediaLab.App.Theme.OS.Editions.WindowsXP.Views.ModuleSettingsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Tahoma" FontSize="11" Foreground="Black"
 Background="{DynamicResource WindowsXP.Face}" UseLayoutRounding="True">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1">
   <DockPanel>
    <Image Source="{Binding SelectedItem.Image, ElementName=Machines}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,12,0"/>
    <Label Content="{l:Loc Emulation.Configuration.Machine}" Target="{Binding ElementName=Machines}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="Machines" DisplayMemberPath="DisplayName" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <DockPanel DockPanel.Dock="Bottom" Margin="12" LastChildFill="False">
   <Button x:Name="CreateAction" Content="{l:Loc Common.Create}" Click="CreateClick" MinWidth="90"/>
   <Button DockPanel.Dock="Right" Content="{l:Loc Common.Close}" Click="CloseClick" MinWidth="90" IsDefault="True"/>
  </DockPanel>
  <Grid Margin="12,12,12,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox x:Name="Categories" SelectionChanged="CategoryChanged" HorizontalContentAlignment="Stretch"/>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel x:Name="Fields" MinWidth="380"/>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>
