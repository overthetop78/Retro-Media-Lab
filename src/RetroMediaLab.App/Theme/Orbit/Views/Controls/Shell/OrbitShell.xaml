<UserControl x:Class="RetroMediaLab.App.Theme.Orbit.Views.OrbitShell" x:ClassModifier="internal" x:Name="Shell"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:o="clr-namespace:RetroMediaLab.App.Theme.Orbit" xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions"
 Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="{x:Static o:OrbitMetrics.RailColumn}"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="5" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="0,0,1,0">
   <StackPanel Margin="6,12,6,0">
    <TextBlock Text="{l:Loc App.Title}" FontSize="10" Foreground="{DynamicResource Orbit.Muted}" TextAlignment="Center" Margin="0,0,0,18" TextTrimming="CharacterEllipsis"/>
    <ToggleButton x:Name="Machines" Tag="{x:Static o:OrbitArea.Machines}" Click="Navigate" Padding="2,10" Margin="0,0,0,8" ToolTip="{l:Loc Options.Themes.Orbit.Machines}">
     <StackPanel><Path Data="M 2,2 L 26,2 L 26,18 L 2,18 Z M 9,24 L 19,24 M 14,18 L 14,24" Stroke="{DynamicResource Orbit.Accent}" StrokeThickness="1.5" Width="28" Height="26" Stretch="Uniform"/><TextBlock Text="{l:Loc Options.Themes.Orbit.Machines}" FontSize="10" TextAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    </ToggleButton>
    <ToggleButton x:Name="Media" Tag="{x:Static o:OrbitArea.Media}" Click="Navigate" Padding="2,10" Margin="0,0,0,8" ToolTip="{l:Loc Options.Themes.Orbit.Media}">
     <StackPanel><Path Data="M 14,1 A 13,13 0 1 1 13.9,1 M 14,10 A 4,4 0 1 1 13.9,10 M 4,8 L 10,11" Stroke="{DynamicResource Orbit.Muted}" StrokeThickness="1.5" Width="28" Height="28" Stretch="Uniform"/><TextBlock Text="{l:Loc Options.Themes.Orbit.Media}" FontSize="10" TextAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    </ToggleButton>
    <ToggleButton x:Name="Journal" Tag="{x:Static o:OrbitArea.Journal}" Click="Navigate" Padding="2,10" Margin="0,0,0,8" ToolTip="{l:Loc Options.Themes.Orbit.Journal}">
     <StackPanel><Path Data="M 1,14 L 6,14 L 9,3 L 15,25 L 19,11 L 23,14 L 28,14" Stroke="{DynamicResource Orbit.Muted}" StrokeThickness="1.5" Width="28" Height="25" Stretch="Uniform"/><TextBlock Text="{l:Loc Options.Themes.Orbit.Journal}" FontSize="10" TextAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    </ToggleButton>
    <ToggleButton x:Name="Commands" Tag="{x:Static o:OrbitArea.Commands}" Click="Navigate" Padding="2,10" ToolTip="{l:Loc Options.Themes.Orbit.Commands}">
     <StackPanel><Path Data="M 1,1 L 9,1 L 9,9 L 1,9 Z M 17,1 L 25,1 L 25,9 L 17,9 Z M 1,17 L 9,17 L 9,25 L 1,25 Z M 17,17 L 25,17 L 25,25 L 17,25 Z" Stroke="{DynamicResource Orbit.Muted}" StrokeThickness="1.5" Width="26" Height="26" Stretch="Uniform"/><TextBlock Text="{l:Loc Options.Themes.Orbit.Commands}" FontSize="10" TextAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    </ToggleButton>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="20,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Heading" FontSize="23" FontWeight="Light"/><TextBlock Text="{Binding ContextTitle, ElementName=Shell}" Foreground="{DynamicResource Orbit.Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
   <Button Grid.Column="1" x:Name="ContextToggle" Content="{l:Loc Options.Themes.Orbit.Context}" Click="ToggleContext" VerticalAlignment="Center" Margin="12,0,0,0"/>
  </Grid>
  <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="20,0,20,12" BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
   <Grid><ContentPresenter Content="{Binding SessionContent, ElementName=Shell}"/>
    <TextBlock x:Name="NoSessions" Text="{l:Loc Options.Themes.Orbit.NoSessions}" Foreground="{DynamicResource Orbit.Muted}" FontSize="11"/>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Grid.Row="2" Margin="20,0,20,16">
   <ContentPresenter x:Name="Work"/>
   <StackPanel x:Name="EmptyMachine" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Ellipse Width="100" Height="100" Stroke="{DynamicResource Orbit.Border}" StrokeThickness="1" Margin="0,0,0,20"/>
    <TextBlock Text="{l:Loc Options.Themes.Orbit.ChooseMachine}" Foreground="{DynamicResource Orbit.Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="350"/>
   </StackPanel>
  </Grid>
  <Border Grid.Column="2" Grid.Row="2" Grid.RowSpan="2" x:Name="Drawer" Width="300" Margin="0,0,16,16" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="Collapsed">
   <DockPanel><TextBlock Text="{l:Loc Options.Themes.Orbit.Context}" Foreground="{DynamicResource Orbit.Muted}" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,16"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentPresenter Content="{Binding ContextContent, ElementName=Shell}"/></ScrollViewer>
   </DockPanel>
  </Border>
  <Border x:Name="JournalPanel" Grid.Column="1" Grid.Row="3" MaxHeight="240" Height="170" Margin="20,0,20,16" Background="{DynamicResource Orbit.Surface}" CornerRadius="8" Visibility="Collapsed" Padding="12">
   <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button x:Name="JournalClose" Content="{l:Loc Common.Close}" Click="CloseJournal" DockPanel.Dock="Right" Padding="8,3" MinHeight="24"/><TextBlock Text="{l:Loc Options.Themes.Orbit.Journal}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ContentPresenter Content="{Binding JournalContent, ElementName=Shell}"/></DockPanel>
  </Border>
  <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="0,1,0,0" Padding="20,0">
   <DockPanel><TextBlock Text="{Binding StatusText, ElementName=Shell}" DockPanel.Dock="Right" Foreground="{DynamicResource Orbit.Accent}" FontSize="11" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding HardwareText, ElementName=Shell}" Foreground="{DynamicResource Orbit.Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
