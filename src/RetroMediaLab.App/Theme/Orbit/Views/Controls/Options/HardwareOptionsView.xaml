<UserControl x:Class="RetroMediaLab.App.Theme.Orbit.Views.HardwareOptionsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:choices="clr-namespace:RetroMediaLab.App.Dictionaries.Options"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}">


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Expander IsExpanded="True" Margin="0,0,0,20" Header="{l:Loc Options.Hardware}">
            <DockPanel Margin="8">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="ScanAction" Content="{l:Loc Hardware.Scan}" Margin="0,0,8,0"/>
                    <Button x:Name="AddAction" Content="{l:Loc Hardware.AddDrive}"/>
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc Options.HardwarePersistence}" Margin="0,8,0,0"/>
                <ListBox MaxHeight="320" x:Name="Drives" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="3,5" MinWidth="540">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{l:Loc Common.Save}" Click="SaveDriveClick" Margin="0,0,6,0"/>
                                    <Button Content="{l:Loc Hardware.Forget}" Click="ForgetDriveClick"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"><Ellipse.Style><Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Orbit.Muted}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Available}" Value="True"><Setter Property="Fill" Value="{DynamicResource Orbit.Success}"/></DataTrigger></Style.Triggers>
                                    </Style></Ellipse.Style></Ellipse>
                                    <TextBlock Text="{Binding Port}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ReaderLabel}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding AvailabilityState}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ConfigurationState}"/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Grid.Row="1">
                                <TextBlock Text="{l:Loc Hardware.SizeShort}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="75" ItemsSource="{x:Static choices:HardwareChoices.Sizes}" SelectedItem="{Binding Size, Mode=TwoWay}" Margin="0,0,12,0"/>
                                <TextBlock Text="{l:Loc Hardware.DensityShort}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="90" ItemsSource="{x:Static choices:HardwareChoices.Densities}" SelectedItem="{Binding Density, Mode=TwoWay}" Margin="0,0,12,0">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding}" Value="Unknown"><Setter Property="Text" Value="{l:Loc Common.Unknown}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{l:Loc Hardware.SpeedShort}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="90" ItemsSource="{x:Static choices:HardwareChoices.Speeds}" SelectedItem="{Binding Rpm, Mode=TwoWay}"/>
                            </WrapPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Expander>
        <Expander IsExpanded="True" Margin="0,0,0,20" Header="{l:Loc HostTools.Title}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8">
                    <TextBlock Text="{l:Loc Options.GwPath}" Margin="0,0,0,4"/>
                    <DockPanel><Button DockPanel.Dock="Right" Content="{l:Loc Common.Choose}" Click="BrowseClick" Margin="8,0,0,0"/>
                        <TextBox x:Name="ToolPath" LostKeyboardFocus="PathEditingFinished"/></DockPanel>
                    <WrapPanel Margin="0,12,0,8">
                        <Button Content="{l:Loc HostTools.Detect}" Click="DetectClick" Margin="0,0,8,0"/>
                        <Button Content="{l:Loc HostTools.Check}" Click="CheckClick" Margin="0,0,8,0"/>
                        <Button x:Name="DownloadAction" Content="{l:Loc HostTools.Download}" Margin="0,0,8,0"/>
                        <Button Content="{l:Loc HostTools.Rollback}" Click="RollbackClick"/>
                    </WrapPanel>
                    <ProgressBar x:Name="Progress" Height="14" Margin="0,0,0,8"/>
                    <TextBlock x:Name="State" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Expander>
    </StackPanel></ScrollViewer>
</UserControl>
