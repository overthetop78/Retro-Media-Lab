<UserControl x:Class="RetroMediaLab.App.Theme.Orbit.Views.LogsOptionsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}">


    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{l:Loc Options.LogsDescription}" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{l:Loc Options.LogUnlimitedHint}" Margin="0,0,0,6"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="{l:Loc Options.OpenLogsFolder}" Click="OpenFolderClick" Margin="8,0,0,0"/>
                <TextBlock x:Name="Directory" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Grid.IsSharedSizeScope="True">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="LogAction"/><ColumnDefinition Width="Auto" SharedSizeGroup="LogEnabled"/><ColumnDefinition Width="Auto" SharedSizeGroup="LogSize"/><ColumnDefinition Width="Auto" SharedSizeGroup="LogArchive"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Options.Logs}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{l:Loc Options.EnableLogs}" MaxWidth="150" Margin="0,0,12,0" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="2" Text="{l:Loc Options.LogMaximumSize}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="3" Text="{l:Loc Options.KeepLogArchives}" MaxWidth="180" TextWrapping="Wrap"/>
                </Grid>
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="LogAction"/><ColumnDefinition Width="Auto" SharedSizeGroup="LogEnabled"/><ColumnDefinition Width="Auto" SharedSizeGroup="LogSize"/><ColumnDefinition Width="Auto" SharedSizeGroup="LogArchive"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox Grid.Column="1" AutomationProperties.Name="{l:Loc Options.EnableLogs}" IsChecked="{Binding Settings.Enabled, Mode=TwoWay}" Click="RowChanged" VerticalAlignment="Center"/>
                            <DockPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock DockPanel.Dock="Right" Text="{l:Loc Options.Kilobytes}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Settings.MaximumKilobytes, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                         MinWidth="65" LostKeyboardFocus="MaximumSizeEditingFinished" PreviewTextInput="NumericTextInput"/>
                            </DockPanel>
                            <CheckBox Grid.Column="3" AutomationProperties.Name="{l:Loc Options.KeepLogArchives}" IsChecked="{Binding Settings.KeepArchives, Mode=TwoWay}" Click="RowChanged" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
