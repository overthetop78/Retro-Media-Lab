<UserControl x:Class="RetroMediaLab.App.Theme.Orbit.Views.ThemeOptionsView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,24,0"><StackPanel>
   <Label Content="{l:Loc Options.Themes.List}" Target="{Binding ElementName=ThemeChoices}"/><ComboBox x:Name="ThemeChoices" DisplayMemberPath="Name" Margin="0,0,0,18"/>
   <TextBlock x:Name="EditionHeading" Foreground="{DynamicResource Orbit.Muted}" Margin="0,0,0,6"/><ComboBox x:Name="EditionChoices" Margin="0,0,0,18"/>
   <TextBlock x:Name="AppearanceHeading" Foreground="{DynamicResource Orbit.Muted}" Margin="0,0,0,6"/><ComboBox x:Name="EditionAppearance" Margin="0,0,0,10"/>
   <WrapPanel x:Name="Variants" Margin="0,0,0,18"/><TextBlock x:Name="Description" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Column="1" Background="{DynamicResource Orbit.Surface}" BorderBrush="{DynamicResource Orbit.Border}" BorderThickness="1" CornerRadius="8" Padding="12">
   <Grid><Image x:Name="Preview" Stretch="Uniform"/><TextBlock x:Name="PreviewUnavailable" Text="{l:Loc Options.Themes.PreviewUnavailable}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Orbit.Muted}"/></Grid>
  </Border>
  <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0"><Button x:Name="ChooseAction" DockPanel.Dock="Right" Content="{l:Loc Common.Choose}" Style="{StaticResource Orbit.Primary}" Margin="12,0,0,0"/>
   <TextBlock x:Name="ActiveTheme" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Orbit.Muted}"/>
  </DockPanel>
 </Grid>
</UserControl>
