<UserControl x:Class="RetroMediaLab.App.Theme.Orbit.Views.TerminalView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions"
 Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <Button x:Name="CloseCommand" Content="{l:Loc Common.Close}" Click="CloseClick" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,3" MinHeight="24"/>
   <Button x:Name="CopyCommand" Content="{l:Loc Common.Copy}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,3" MinHeight="24"/>
   <TextBox x:Name="Command" IsReadOnly="True" Background="Transparent" TextWrapping="Wrap" BorderThickness="0"
    FontFamily="Consolas" FontSize="11" MinHeight="24"/>
  </DockPanel>
  <RichTextBox x:Name="Output" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" Background="{DynamicResource Orbit.Window}"
   Foreground="{DynamicResource Orbit.Text}" BorderThickness="0" FontFamily="Consolas" FontSize="12"
   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><FlowDocument PagePadding="0"/></RichTextBox>
 </Grid>
</UserControl>
