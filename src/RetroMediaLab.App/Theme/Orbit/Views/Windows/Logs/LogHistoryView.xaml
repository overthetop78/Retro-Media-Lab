<UserControl x:Class="RetroMediaLab.App.Theme.Orbit.Views.LogHistoryView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:RetroMediaLab.App.Localization.Extensions" Background="{DynamicResource Orbit.Window}" Foreground="{DynamicResource Orbit.Text}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button x:Name="ExportCommand" Content="{l:Loc Common.Export}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
   <ComboBox x:Name="Files" DisplayMemberPath="Name"/>
  </DockPanel>
  <TextBox x:Name="Output" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
  <Button Grid.Row="2" Content="{l:Loc Common.Close}" Click="CloseClick" HorizontalAlignment="Right" Margin="0,18,0,0"/>
 </Grid>
</UserControl>
